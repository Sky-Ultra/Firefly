{
	"name": "firefly",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"run_worker_first": ["/api/private/*"],
		"binding": "ASSETS"
	},
	"main": "worker/index.mjs",
	"preview_urls": false,
	"durable_objects": {
		"bindings": [
			{
				"name": "PRIVATE_ARTICLES",
				"class_name": "PrivateArticleBackend"
			}
		]
	},
	"migrations": [
		{
			"tag": "private-article-v1",
			"new_sqlite_classes": ["PrivateArticleBackend"]
		}
	]
}
