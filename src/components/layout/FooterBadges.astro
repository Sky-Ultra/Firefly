---
import { Icon } from "astro-icon/components";
import { analyticsConfig, commentConfig, licenseConfig } from "@/config";
import { getFooterBadges } from "@/utils/footer-badges";

const badges = getFooterBadges({
	commentService: commentConfig.type,
	umamiEnabled: Boolean(analyticsConfig.umamiAnalytics?.websiteId),
	license: licenseConfig,
});
---

<div
	class="footer-badges"
	role="list"
	aria-label="网站技术与服务"
	data-i18n-zh="网站技术与服务"
	data-i18n-en="Site technology and services"
	data-i18n-attr="aria-label"
	data-i18n-skip
	data-pagefind-ignore
>
	{badges.map((badge) => (
		<div
			class="footer-badge"
			role="listitem"
			style={`--badge-color: ${badge.color}`}
		>
			<span class="badge-label">
				<Icon is:inline name={badge.icon} class="badge-icon" aria-hidden="true" />
				<span class="sr-only">{badge.label}: </span>
			</span>
			{badge.href ? (
				<a class="badge-value" href={badge.href} target="_blank" rel="noopener noreferrer">
					{badge.value}
				</a>
			) : (
				<span class="badge-value">{badge.value}</span>
			)}
		</div>
	))}
</div>

<style>
	.footer-badges {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 7px;
		max-width: 100%;
		margin-top: 14px;
		margin-bottom: 23px;
	}

	.footer-badge {
		display: inline-flex;
		align-items: center;
		overflow: hidden;
		border-radius: 7px;
		border: 1px solid color-mix(in srgb, var(--badge-color) 25%, var(--line-divider));
		background: color-mix(in srgb, var(--badge-color) 5%, var(--card-bg));
		color: var(--badge-color);
		font-size: 11px;
		font-weight: 600;
		line-height: 16px;
		padding: 4px 8px;
		white-space: nowrap;
	}

	.badge-label,
	.badge-value {
		display: inline-flex;
		align-items: center;
	}

	.badge-label {
		margin-right: 4px;
	}

	.badge-icon {
		width: 13px;
		height: 13px;
	}

	.badge-value {
		color: inherit;
		text-decoration: none;
	}

	a.badge-value:hover {
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	a.badge-value:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: -3px;
	}

	:global(.dark) .footer-badge {
		color: color-mix(in srgb, var(--badge-color) 45%, white);
	}

	@media (max-width: 640px) {
		.footer-badges {
			max-width: min(100%, 280px);
			margin-inline: auto;
		}
	}
</style>
