---
import { Icon } from "astro-icon/components";

const meteors = [
	[7, 18, 0.4],
	[34, 74, 2.2],
	[58, 30, 4.1],
];
---

<night-letter-sky class="letter-sky" aria-hidden="true">
	<Icon is:inline name="material-symbols:star-outline-rounded" class="letter-watermark" />
	<span class="letter-twinkle letter-twinkle-top"></span>
	<span class="letter-twinkle letter-twinkle-bottom"></span>
	{meteors.map(([x, y, delay]) => (
		<span class="letter-meteor" style={`--meteor-x: ${x}%; --meteor-y: ${y}%; --meteor-delay: ${delay}s;`}></span>
	))}
</night-letter-sky>

<style>
	.letter-sky {
		position: absolute;
		z-index: 0;
		inset: 0;
		overflow: hidden;
		border-radius: inherit;
		pointer-events: none;
		color: var(--primary);
		background:
			radial-gradient(ellipse at 96% 92%, color-mix(in srgb, currentColor 27%, transparent), transparent 68%),
			linear-gradient(120deg, color-mix(in srgb, currentColor 12%, transparent), transparent 80%);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 30%, transparent);
	}
	.letter-watermark {
		position: absolute;
		bottom: -1.1rem;
		right: -.5rem;
		width: 8rem;
		height: 8rem;
		opacity: .22;
		transform: rotate(-14deg);
	}
	.letter-twinkle, .letter-meteor::after {
		width: .48rem;
		height: .48rem;
		background: currentColor;
		clip-path: polygon(50% 0, 64% 36%, 100% 50%, 64% 64%, 50% 100%, 36% 64%, 0 50%, 36% 36%);
	}
	.letter-twinkle {
		position: absolute;
		opacity: .46;
	}
	.letter-twinkle-top { top: 12%; right: 28%; }
	.letter-twinkle-bottom { bottom: 9%; left: 17%; }
	.letter-meteor {
		position: absolute;
		top: var(--meteor-y);
		left: var(--meteor-x);
		width: clamp(1.6rem, 15%, 3.1rem);
		height: 2px;
		border-radius: 999px;
		background: linear-gradient(90deg, transparent, currentColor);
		opacity: 0;
		animation: letter-meteor-drift 6.8s linear var(--meteor-delay) infinite paused;
	}
	.letter-meteor::after {
		position: absolute;
		top: 50%;
		right: 0;
		content: "";
		transform: translate(25%, -50%);
	}
	.letter-sky[data-visible] .letter-meteor { animation-play-state: running; }
	@keyframes letter-meteor-drift {
		0%, 100% { opacity: 0; transform: translate3d(0, -.16rem, 0) rotate(8deg); }
		6% { opacity: .63; }
		26% { opacity: 0; transform: translate3d(3.5rem, .55rem, 0) rotate(8deg); }
		27%, 99% { opacity: 0; }
	}
	@media (max-width: 767px) {
		.letter-watermark { width: 6.6rem; height: 6.6rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.letter-meteor { animation: none; }
	}
</style>

<script>
	class NightLetterSky extends HTMLElement {
		private observer?: IntersectionObserver;

		connectedCallback(): void {
			if (!("IntersectionObserver" in window)) return;
			this.observer = new IntersectionObserver(([entry]) => {
				this.toggleAttribute("data-visible", Boolean(entry?.isIntersecting));
			});
			this.observer.observe(this);
		}

		disconnectedCallback(): void {
			this.observer?.disconnect();
			this.removeAttribute("data-visible");
		}
	}

	if (!customElements.get("night-letter-sky")) {
		customElements.define("night-letter-sky", NightLetterSky);
	}
</script>
