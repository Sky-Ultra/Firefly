---
import { Icon } from "astro-icon/components";

const meteors = [
	[48, 17],
	[56, 67],
	[57, 51],
	[66, 26],
	[19, 84],
	[69, 13],
	[68, 86],
	[42, 74],
	[7, 57],
];
const stars = [
	[14, 88],
	[38, 14],
	[62, 30],
	[77, 55],
	[90, 22],
];
---

<night-letter-sky class="letter-sky" aria-hidden="true">
	<Icon is:inline name="material-symbols:star-outline-rounded" class="letter-watermark" />
	{stars.map(([x, y]) => (
		<span class="letter-twinkle" style={`--star-x: ${x}%; --star-y: ${y}%;`}></span>
	))}
	{meteors.map(([x, y], index) => (
		<span class="letter-meteor" style={`--star-x: ${x}%; --star-y: ${y}%; --meteor-delay: -${index * 700}ms;`}></span>
	))}
</night-letter-sky>

<style>
	:global(.night-letter-card) {
		--letter-accent: var(--btn-content);
	}
	:global(.night-letter-card)::before {
		position: absolute;
		z-index: 0;
		inset: 0;
		border-radius: inherit;
		pointer-events: none;
		color: var(--letter-accent);
		content: "";
		background:
			radial-gradient(ellipse at 100% 88%, color-mix(in srgb, var(--primary) 57%, transparent), transparent 73%),
			linear-gradient(126deg, color-mix(in srgb, var(--primary) 23%, transparent), color-mix(in srgb, var(--primary) 8%, transparent) 52%, color-mix(in srgb, var(--letter-accent) 20%, transparent));
		box-shadow:
			inset 0 0 0 1px color-mix(in srgb, currentColor 46%, transparent),
			inset 0 0 1.35rem color-mix(in srgb, var(--primary) 19%, transparent);
	}
	.letter-sky {
		position: absolute;
		z-index: -1;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		color: var(--letter-accent);
	}
	.letter-watermark {
		position: absolute;
		bottom: -1.1rem;
		right: -.5rem;
		width: 8rem;
		height: 8rem;
		opacity: .32;
		transform: rotate(-14deg);
	}
	.letter-twinkle, .letter-meteor::after {
		width: .6rem;
		height: .6rem;
		background: currentColor;
		clip-path: polygon(50% 0, 64% 36%, 100% 50%, 64% 64%, 50% 100%, 36% 64%, 0 50%, 36% 36%);
	}
	.letter-twinkle, .letter-meteor {
		position: absolute;
		top: var(--star-y);
		left: var(--star-x);
	}
	.letter-twinkle { opacity: .35; }
	.letter-twinkle:nth-of-type(even) { transform: scale(.66); }
	.letter-meteor {
		width: clamp(1.2rem, 13%, 3.65rem);
		height: 2px;
		border-radius: 999px;
		background: linear-gradient(90deg, transparent, var(--primary) 65%, currentColor);
		opacity: 0;
		animation: letter-meteor-drift 6.3s linear var(--meteor-delay) infinite paused;
	}
	.letter-meteor::after {
		position: absolute;
		top: 50%;
		right: 0;
		content: "";
		transform: translate(25%, -50%);
	}
	.letter-sky[data-visible] .letter-meteor { animation-play-state: running; }
	@keyframes letter-meteor-drift {
		0% { opacity: 0; transform: translate3d(-.55rem, -.35rem, 0) rotate(10deg); }
		7%, 23% { opacity: .88; }
		46%, 100% { opacity: 0; transform: translate3d(110%, .48rem, 0) rotate(10deg); }
	}
	@media (max-width: 767px) {
		.letter-watermark { width: 6.6rem; height: 6.6rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.letter-meteor { animation: none; }
	}
</style>

<script>
	class NightLetterSky extends HTMLElement {
		private observer?: IntersectionObserver;

		connectedCallback(): void {
			if (!("IntersectionObserver" in window)) {
				this.setAttribute("data-visible", "");
				return;
			}
			this.observer = new IntersectionObserver(([entry]) => {
				this.toggleAttribute("data-visible", Boolean(entry?.isIntersecting));
			});
			this.observer.observe(this);
		}

		disconnectedCallback(): void {
			this.observer?.disconnect();
			this.removeAttribute("data-visible");
		}
	}

	if (!customElements.get("night-letter-sky")) {
		customElements.define("night-letter-sky", NightLetterSky);
	}
</script>
