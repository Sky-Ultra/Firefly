---
import { Picture } from "astro:assets";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import DisplaySettings from "@/components/controls/DisplaySettingsIntegrated.svelte";
import LightDarkSwitch from "@/components/controls/LightDarkSwitch.svelte";
import Search from "@/components/controls/Search.svelte";
import MusicPlayer from "@/components/features/MusicPlayer.astro";
import { backgroundWallpaper, navBarConfig, siteConfig } from "@/config";
import { musicPlayerConfig } from "@/config/musicConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { NavBarLink } from "@/types/config";
import { getFallbackFormat, getImageFormats } from "@/utils/image-utils";
import { isHomePage } from "@/utils/layout-utils";
import { url } from "@/utils/url-utils";
import DropdownMenu from "./DropdownMenu.astro";

const className = Astro.props.class;

// 获取导航栏透明模式配置
const navbarTransparentMode =
	backgroundWallpaper.mode === "banner"
		? backgroundWallpaper.common?.navbar?.transparentMode || "semi"
		: "semi";

// 获取导航栏毛玻璃效果配置
const navbarEnableBlur =
	backgroundWallpaper.mode === "banner"
		? (backgroundWallpaper.common?.navbar?.enableBlur ?? true)
		: false;

// 获取导航栏模糊度
const navbarBlur =
	backgroundWallpaper.mode === "banner"
		? (backgroundWallpaper.common?.navbar?.blur ?? 20)
		: 0;

// 获取导航栏标题，如果没有设置则使用 siteConfig.title
const navbarTitle = siteConfig.navbar.title || siteConfig.title;

// 获取导航栏宽度配置
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;
const navbarMenuAlign = siteConfig.navbar.menuAlign ?? "center";
const isNavbarMenuCentered = navbarMenuAlign === "center";

// 检查是否为首页
const isHomePageCheck = isHomePage(Astro.url.pathname);

// 检查是否有任何显示设置可用
const showThemeColor = !siteConfig.themeColor.fixed;
const isWallpaperSwitchable = backgroundWallpaper.switchable ?? true;
const allowLayoutSwitch = siteConfig.postListLayout.allowSwitch;
const hasDisplaySettings =
	showThemeColor || isWallpaperSwitchable || allowLayoutSwitch;

// 根据 siteConfig.pages 过滤导航栏链接
const pages = siteConfig.pages;

function isPageEnabled(link: NavBarLink): boolean {
	if (!link.pageKey) return true;
	return pages[link.pageKey as keyof typeof pages] !== false;
}

function filterLinks(link: NavBarLink): NavBarLink | null {
	if (!link.children) {
		return isPageEnabled(link) ? link : null;
	}

	const filteredChildren = link.children.filter(isPageEnabled);

	if (filteredChildren.length === 0) return null;
	if (filteredChildren.length === 1) return filteredChildren[0];
	return { ...link, children: filteredChildren };
}

let links: NavBarLink[] = navBarConfig.links
	.map(filterLinks)
	.filter((link): link is NavBarLink => link !== null);

// 处理导航栏 Logo 图片
const logoValue = siteConfig.navbar.logo?.value || "";
const isLocalSrcLogo =
	siteConfig.navbar.logo?.type === "image" &&
	logoValue &&
	!logoValue.startsWith("/") &&
	!logoValue.startsWith("http");
let logoImg: ImageMetadata | null = null;

if (isLocalSrcLogo) {
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
		{ import: "default" },
	);
	const normalizedPath = path
		.normalize(path.join("../../", logoValue))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (file) {
		logoImg = await file();
	}
}
---
<div id="navbar" class="z-50" style={`--navbar-glass-blur: ${navbarBlur}px;`} data-transparent-mode={navbarTransparentMode} data-enable-blur={String(navbarEnableBlur)} data-is-home={isHomePageCheck} data-full-width={navbarWidthFull}>
    <div class:list={[
        className,
        "navbar-shell overflow-visible! h-18 px-4"
    ]}>
        <div class="relative mx-auto grid h-full w-full max-w-(--page-width) grid-cols-[auto_minmax(0,1fr)_auto] items-center">
            <a href={url('/')} class="navbar-brand btn-plain scale-animation rounded-lg h-13 px-5 font-bold active:scale-95">
                <div class:list={[
                    "flex flex-row items-center text-md",
                    siteConfig.navbar.followTheme ? "text-(--primary)" : "dark:text-white text-black"
                ]} style="font-family: var(--font-navbar-title, inherit)">
                                    {siteConfig.navbar.logo?.type === "icon" ? (
                                        <Icon is:inline name={siteConfig.navbar.logo.value || "material-symbols:home-pin-outline"} class="text-[1.75rem] mb-1 mr-2" />
                                    ) : siteConfig.navbar.logo?.type === "image" && logoImg ? (
                                        <Picture
                                            src={logoImg}
                                            alt={siteConfig.navbar.logo.alt || siteConfig.title}
                                            class="h-7 w-7 mb-1 mr-2 shrink-0 rounded-full object-contain"
                                            formats={getImageFormats()}
                                            fallbackFormat={getFallbackFormat()}
                                            widths={[28, 56]}
                                            loading="eager"
                                            fetchpriority="high"
                                        />
                                    ) : siteConfig.navbar.logo?.type === "image" ? (
                                        <img src={url(siteConfig.navbar.logo.value)} alt={siteConfig.navbar.logo.alt || siteConfig.title} class="h-7 w-7 mb-1 mr-2 shrink-0 rounded-full object-contain" fetchpriority="high" />
                                    ) : siteConfig.navbar.logo?.type === "url" ? (
                                        <img src={siteConfig.navbar.logo.value} alt={siteConfig.navbar.logo.alt || siteConfig.title} class="h-7 w-7 mb-1 mr-2 shrink-0 rounded-full object-contain" fetchpriority="high" />
                                    ) : (
                                        <Icon is:inline name="material-symbols:home-pin-outline" class="text-[1.75rem] mb-1 mr-2" />
                                    )}
                    {navbarTitle}
                </div>
            </a>
			<div class:list={[
				"hidden lg:flex items-center space-x-1",
				isNavbarMenuCentered
					? "absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 justify-center"
					: "col-start-2 justify-start pl-2"
			]}>
                {links.map((l) => {
                    return <DropdownMenu link={l} />;
                })}
            </div>
            <div class="flex items-center col-start-3 justify-self-end">
                <div class="flex items-center lg:hidden" aria-label="Mobile navigation">
                    {links.map((link) => (
                        link.children && link.children.length > 0 ? (
                            <div class="mobile-navbar-item" data-mobile-navbar-item>
                                <button
                                    type="button"
                                    class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90"
                                    aria-label={link.name}
                                    title={link.name}
                                    aria-expanded="false"
                                    data-mobile-navbar-trigger
                                >
                                    <span class="mobile-navbar-icon">
                                        {link.icon && <Icon is:inline name={link.icon} class="text-[1.15rem]" />}
                                    </span>
                                    <span class="mobile-navbar-label">{link.name}</span>
                                </button>
                                <div
                                    class="mobile-navbar-panel float-panel float-panel-closed fixed right-4 p-2 max-h-[80vh] overflow-y-auto z-50"
                                    data-mobile-navbar-panel
                                >
                                    {link.children.map((child) => (
                                        <a
                                            href={child.external ? child.url : url(child.url)}
                                            class="group flex justify-between items-center py-2 pl-3 pr-2 rounded-lg gap-8 hover:bg-(--btn-plain-bg-hover) active:bg-(--btn-plain-bg-active) transition"
                                            target={child.external ? "_blank" : null}
                                            rel={child.external ? "noopener noreferrer" : null}
                                        >
                                            <div class="flex items-center whitespace-nowrap text-black/75 dark:text-white/75 font-medium group-hover:text-(--primary) group-active:text-(--primary) transition">
                                                {child.icon && <Icon is:inline name={child.icon} class="text-[1.1rem] mr-2" />}
                                                {child.name}
                                            </div>
                                            {child.external && (
                                                <Icon
                                                    is:inline
                                                    name="fa7-solid:arrow-up-right-from-square"
                                                    class="text-[0.75rem] text-black/25 dark:text-white/25"
                                                />
                                            )}
                                        </a>
                                    ))}
                                </div>
                            </div>
                        ) : (
                            <a
                                href={link.external ? link.url : url(link.url)}
                                class="mobile-navbar-link btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90"
                                aria-label={link.name}
                                title={link.name}
                                target={link.external ? "_blank" : null}
                                rel={link.external ? "noopener noreferrer" : null}
                            >
                                <span class="mobile-navbar-icon">
                                    {link.url === "/about/" ? (
                                        <Icon is:inline name="material-symbols:info" class="text-[1.15rem]" />
                                    ) : (
                                        link.icon && <Icon is:inline name={link.icon} class="text-[1.15rem]" />
                                    )}
                                </span>
                                <span class="mobile-navbar-label">{link.name}</span>
                            </a>
                        )
                    ))}
                </div>
                <!--<SearchPanel client:load>-->
                <Search
                    client:load
                />
                {musicPlayerConfig.showInNavbar && (
                    <button aria-label={i18n(I18nKey.music)} class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90 hidden lg:flex" id="music-player-switch">
                        <Icon is:inline name="material-symbols:music-note-rounded" class="text-[1.25rem]"></Icon>
                    </button>
                )}
                {backgroundWallpaper.playerEnable && backgroundWallpaper.mode !== "none" && (
                    <button
                        aria-label={i18n(I18nKey.videoPlay)}
                        class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90 hidden lg:flex"
                        id="bg-player-toggle"
                        data-i18n-play={i18n(I18nKey.videoPlay)}
                        data-i18n-pause={i18n(I18nKey.videoPause)}
                    >
                        <Icon is:inline name="material-symbols:play-arrow-rounded" class="text-[1.5rem]" />
                    </button>
                )}
                {hasDisplaySettings && (
                        <button aria-label="Display Settings" class="mobile-navbar-utility btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                            <Icon is:inline name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                        </button>
                )}
                {/* @ts-ignore */}
                <LightDarkSwitch client:load></LightDarkSwitch>
                <button
                    type="button"
                    aria-label="更多工具"
                    title="更多工具"
                    aria-expanded="false"
                    class="mobile-navbar-utility btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 lg:hidden!"
                    id="mobile-tools-switch"
                >
                    <Icon is:inline name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
                </button>
            </div>
        </div>
        {musicPlayerConfig.showInNavbar && (
            <div id="music-nav-panel" class="float-panel float-panel-closed absolute transition-all right-16 p-2 pt-4.5 w-80 z-50">
                <MusicPlayer />
            </div>
        )}
        <div
            id="mobile-tools-panel"
            class="float-panel float-panel-closed transition-all fixed right-4 p-2 z-50 lg:hidden"
            aria-label="移动端工具"
        >
            <div class="flex items-center">
                <button
                    type="button"
                    aria-label={i18n(I18nKey.search)}
                    title={i18n(I18nKey.search)}
                    class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90"
                    data-mobile-tool-target="search-switch"
                >
                    <Icon is:inline name="material-symbols:search" class="text-[1.25rem]" />
                </button>
                {musicPlayerConfig.showInNavbar && (
                    <button
                        type="button"
                        aria-label={i18n(I18nKey.music)}
                        title={i18n(I18nKey.music)}
                        class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90"
                        data-mobile-tool-target="music-player-switch"
                    >
                        <Icon is:inline name="material-symbols:music-note-rounded" class="text-[1.25rem]" />
                    </button>
                )}
                {backgroundWallpaper.playerEnable && backgroundWallpaper.mode !== "none" && (
                    <button
                        type="button"
                        aria-label={i18n(I18nKey.videoPlay)}
                        title={i18n(I18nKey.videoPlay)}
                        class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90"
                        data-mobile-tool-target="bg-player-toggle"
                    >
                        <Icon is:inline name="material-symbols:play-arrow-rounded" class="text-[1.5rem]" />
                    </button>
                )}
                <button
                    type="button"
                    aria-label="明暗模式"
                    title="明暗模式"
                    class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90"
                    data-mobile-tool-target="scheme-switch"
                >
                    <Icon is:inline name="material-symbols:wb-sunny-outline-rounded" class="text-[1.25rem]" />
                </button>
            </div>
        </div>
        <DisplaySettings client:load></DisplaySettings>
    </div>
</div>

<style>
    @media (max-width: 1023px) {
        :global(#navbar #search-switch),
        :global(#navbar #scheme-switch) {
            display: none !important;
        }

        .mobile-navbar-item,
        .mobile-navbar-link {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .mobile-navbar-item > button,
        .mobile-navbar-link {
            flex-direction: column;
            gap: 0.16rem;
        }

        .mobile-navbar-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

        .mobile-navbar-label {
            color: inherit;
            font-size: 0.6rem;
            font-weight: 600;
            line-height: 1;
            white-space: nowrap;
        }

        .mobile-navbar-panel {
            top: 5.25rem;
            min-width: 11rem;
        }

        #mobile-tools-panel {
            top: 5.25rem;
        }

        .navbar-shell {
            padding-inline: 0.5rem;
        }

        .navbar-brand {
            padding-inline: 0.5rem;
        }

        .mobile-navbar-item > button,
        .mobile-navbar-link {
            width: 2.5rem;
            height: 3.25rem;
        }

        .mobile-navbar-utility {
            width: 2.5rem;
            height: 3.25rem;
            flex-direction: column;
            gap: 0.16rem;
        }

        .mobile-navbar-utility::after {
            content: "";
            display: block;
            flex: 0 0 0.6rem;
            width: 1px;
        }
    }

    @media (max-width: 380px) {
        .mobile-navbar-item > button,
        .mobile-navbar-link {
            width: 2.25rem;
            height: 3.25rem;
        }

        .mobile-navbar-utility {
            width: 2.25rem;
            height: 3.25rem;
        }

        .mobile-navbar-label {
            font-size: 0.55rem;
        }

        .mobile-navbar-utility::after {
            flex-basis: 0.55rem;
        }
    }
</style>

<script>
function loadButtonScript() {
    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    const mobileNavbarItems = document.querySelectorAll<HTMLElement>("[data-mobile-navbar-item]");
    const closeMobileNavbarPanels = (exceptItem?: HTMLElement) => {
        mobileNavbarItems.forEach((item) => {
            if (item === exceptItem) return;
            item.querySelector<HTMLElement>("[data-mobile-navbar-panel]")?.classList.add("float-panel-closed");
            item.querySelector<HTMLElement>("[data-mobile-navbar-trigger]")?.setAttribute("aria-expanded", "false");
        });
    };

    mobileNavbarItems.forEach((item) => {
        const trigger = item.querySelector<HTMLElement>("[data-mobile-navbar-trigger]");
        const panel = item.querySelector<HTMLElement>("[data-mobile-navbar-panel]");
        if (!trigger || !panel) return;

        trigger.onclick = function (event) {
            event.stopPropagation();
            const shouldOpen = panel.classList.contains("float-panel-closed");
            document.getElementById("mobile-tools-panel")?.classList.add("float-panel-closed");
            document.getElementById("mobile-tools-switch")?.setAttribute("aria-expanded", "false");
            closeMobileNavbarPanels(item);
            panel.classList.toggle("float-panel-closed", !shouldOpen);
            trigger.setAttribute("aria-expanded", String(shouldOpen));
        };
    });

    let musicBtn = document.getElementById("music-player-switch");
    if (musicBtn) {
        musicBtn.onclick = function () {
            let musicPanel = document.getElementById("music-nav-panel");
            if (musicPanel) {
                musicPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    // 背景视频播放器控制按钮
    let bgPlayerBtn = document.getElementById("bg-player-toggle");
    if (bgPlayerBtn) {
        bgPlayerBtn.onclick = function () {
            window.dispatchEvent(new CustomEvent("bg-player-toggle"));
        };
        window.addEventListener("bg-player-state-change", function (e) {
            var ce = e as CustomEvent;
            var playing = ce.detail && ce.detail.playing;
            var i18nPlay = bgPlayerBtn!.getAttribute("data-i18n-play") ?? "";
            var i18nPause = bgPlayerBtn!.getAttribute("data-i18n-pause") ?? "";
            var label = playing ? i18nPause : i18nPlay;
            bgPlayerBtn!.innerHTML = playing
                ? '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M16 19q-.825 0-1.412-.587T14 17V7q0-.825.588-1.412T16 5t1.413.588T18 7v10q0 .825-.587 1.413T16 19m-8 0q-.825 0-1.412-.587T6 17V7q0-.825.588-1.412T8 5t1.413.588T10 7v10q0 .825-.587 1.413T8 19"/></svg>'
                : '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M8 17.175V6.825q0-.425.3-.713t.7-.287q.125 0 .263.037t.262.113l8.15 5.175q.225.15.338.375t.112.475t-.112.475t-.338.375l-8.15 5.175q-.125.075-.262.113T9 18.175q-.4 0-.7-.288t-.3-.712"/></svg>';
            bgPlayerBtn!.setAttribute("title", label);
            bgPlayerBtn!.setAttribute("aria-label", label);
        });
        // 切换壁纸模式时隐藏/显示播放按钮
        window.addEventListener("wallpaperModeChange", function (e) {
            var ce = e as CustomEvent;
            var mode = ce.detail && ce.detail.mode;
            bgPlayerBtn!.style.display = mode === "none" ? "none" : "";
        });
        // Swup 导航时同步播放按钮状态（BackgroundPlayer 可能被重建，也可能持久存在）
        function syncBgPlayerBtn() {
            var playing = document.documentElement.hasAttribute("data-bg-video-playing");
            var i18nPlay = bgPlayerBtn!.getAttribute("data-i18n-play") ?? "";
            var i18nPause = bgPlayerBtn!.getAttribute("data-i18n-pause") ?? "";
            var label = playing ? i18nPause : i18nPlay;
            bgPlayerBtn!.innerHTML = playing
                ? '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M16 19q-.825 0-1.412-.587T14 17V7q0-.825.588-1.412T16 5t1.413.588T18 7v10q0 .825-.587 1.413T16 19m-8 0q-.825 0-1.412-.587T6 17V7q0-.825.588-1.412T8 5t1.413.588T10 7v10q0 .825-.587 1.413T8 19"/></svg>'
                : '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M8 17.175V6.825q0-.425.3-.713t.7-.287q.125 0 .263.037t.262.113l8.15 5.175q.225.15.338.375t.112.475t-.112.475t-.338.375l-8.15 5.175q-.125.075-.262.113T9 18.175q-.4 0-.7-.288t-.3-.712"/></svg>';
            bgPlayerBtn!.setAttribute("title", label);
            bgPlayerBtn!.setAttribute("aria-label", label);
        }
        if (window.swup && window.swup.hooks) {
            window.swup.hooks.on("content:replace", syncBgPlayerBtn);
        } else {
            document.addEventListener("swup:enable", function () {
                window.swup.hooks.on("content:replace", syncBgPlayerBtn);
            });
        }
    }

    let themeSwitchBtn = document.getElementById("scheme-switch");
    if (themeSwitchBtn) {
        themeSwitchBtn.onclick = function () {
            let themePanel = document.getElementById("theme-mode-panel");
            if (themePanel) {
                themePanel.classList.toggle("float-panel-closed");
            }
        };
    }

    const mobileToolsBtn = document.getElementById("mobile-tools-switch");
    const mobileToolsPanel = document.getElementById("mobile-tools-panel");
    if (mobileToolsBtn && mobileToolsPanel) {
        mobileToolsBtn.onclick = function (event) {
            event.stopPropagation();
            const shouldOpen = mobileToolsPanel.classList.contains("float-panel-closed");
            closeMobileNavbarPanels();
            mobileToolsPanel.classList.toggle("float-panel-closed", !shouldOpen);
            mobileToolsBtn.setAttribute("aria-expanded", String(shouldOpen));
        };
    }

    document.querySelectorAll<HTMLElement>("[data-mobile-tool-target]").forEach((toolButton) => {
        toolButton.onclick = function (event) {
            event.stopPropagation();
            const targetId = toolButton.dataset.mobileToolTarget;
            if (!targetId) return;
            document.getElementById(targetId)?.click();
            mobileToolsPanel?.classList.add("float-panel-closed");
            mobileToolsBtn?.setAttribute("aria-expanded", "false");
        };
    });

    document.addEventListener("click", function(event) {
        const panels = ["display-setting", "music-nav-panel", "theme-mode-panel", "mobile-tools-panel"];
        const buttons = ["display-settings-switch", "music-player-switch", "scheme-switch", "mobile-tools-switch"];

        panels.forEach((id, index) => {
            const panel = document.getElementById(id);
            const button = document.getElementById(buttons[index]);
            if (panel && button && !panel.classList.contains("float-panel-closed")) {
                if (event.target instanceof Node && !panel.contains(event.target) && !button.contains(event.target)) {
                    panel.classList.add("float-panel-closed");
                    button.setAttribute("aria-expanded", "false");
                }
            }
        });

        if (event.target instanceof Node) {
            const clickedInsideMobileNavbar = Array.from(mobileNavbarItems).some((item) => item.contains(event.target as Node));
            if (!clickedInsideMobileNavbar) {
                closeMobileNavbarPanels();
            }
        }
    });
}

loadButtonScript();

// 为semifull模式添加滚动检测逻辑
function initSemifullScrollDetection() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    const transparentMode = navbar.getAttribute('data-transparent-mode');
    if (transparentMode !== 'semifull') return;

    // 无论首页/非首页，semifull 都由滚动位置决定是否进入 scrolled 状态
    // 先移除之前的滚动监听器，避免重复绑定
    if (window.semifullScrollHandler) {
        window.removeEventListener('scroll', window.semifullScrollHandler as () => void);
        window.semifullScrollHandler = undefined;
    }

    // 初始状态不强制加 scrolled，保持透明；滚动后再切换
    navbar.classList.remove('scrolled');

    let ticking = false;

    function updateNavbarState() {
        if (document.documentElement.classList.contains('is-page-transitioning')) {
            navbar!.classList.remove('scrolled');
            ticking = false;
            return;
        }

        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const threshold = 50; // 滚动阈值，可以根据需要调整
        // 使用批量DOM操作优化性能
        if (scrollTop > threshold) {
            navbar!.classList.add('scrolled');
        } else {
            navbar!.classList.remove('scrolled');
        }

        ticking = false;
    }

    function requestTick() {
        if (!ticking) {
            requestAnimationFrame(updateNavbarState);
            ticking = true;
        }
    }

    // 移除之前的滚动事件监听器（如果存在）
    if (window.semifullScrollHandler) {
        window.removeEventListener('scroll', window.semifullScrollHandler as () => void);
    }

    // 保存新的事件处理器引用
    window.semifullScrollHandler = requestTick as unknown as (() => void);

    // 监听滚动事件
    window.addEventListener('scroll', requestTick, { passive: true });

    // 初始化状态
    updateNavbarState();
}

// 将函数暴露到全局对象，供页面切换时调用
window.initSemifullScrollDetection = initSemifullScrollDetection;

// 页面加载完成后初始化滚动检测
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSemifullScrollDetection);
} else {
    initSemifullScrollDetection();
}
