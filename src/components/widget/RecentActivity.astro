---
import { Icon } from "astro-icon/components";
import LocalizedText from "@/components/common/LocalizedText.astro";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import type { WidgetComponentConfig } from "@/types/config";
import { getSiteTimeline } from "@/utils/site-timeline";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const preview = (await getSiteTimeline()).slice(0, 6);
---

<WidgetLayout
	id="recent-activity"
	name="最近发生的事"
	nameEn="Recent activity"
	showTitle={widgetConfig?.showTitle !== false}
	class={className}
	style={style}
>
	<ol class="relative mb-3 max-h-48 overflow-y-auto rounded-md pe-1 [scrollbar-width:thin] focus-visible:outline-(--primary)" tabindex="0" aria-label="近期动态" data-i18n-attr="aria-label" data-i18n-zh="近期动态" data-i18n-en="Recent activity preview">
		{preview.map((item) => {
			const video = item.kind === "moment" ? item.video : undefined;
			const poster = video?.poster;
			return (
				<li class="border-b border-(--line-divider) last:border-0">
					<a
						href={item.href}
						title={video?.title}
						data-i18n-attr={item.kind === "changelog" ? "href" : video ? "title" : undefined}
						data-i18n-zh={item.kind === "changelog" ? item.href : video?.title}
						data-i18n-en={item.kind === "changelog" ? item.hrefEn : video?.titleEn}
						class="flex items-center gap-2 rounded px-1.5 py-2 hover:bg-(--btn-regular-bg) focus-visible:outline-(--primary)"
					>
						<span class="min-w-0 flex-1">
							<span class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-(--content-meta)">
								<time datetime={item.date}>{item.date.slice(5, 10)}</time>
								<LocalizedText
									zh={item.kind === "post" ? "文章" : video ? "视频动态" : item.kind === "moment" ? "朋友圈" : "更新日志"}
									en={item.kind === "post" ? "Article" : video ? "Video moment" : item.kind === "moment" ? "Moment" : "Changelog"}
								/>
							</span>
							<LocalizedText
								class="mt-0.5 line-clamp-2 text-sm leading-snug text-75 [overflow-wrap:anywhere]"
								zh={item.kind === "post" ? item.title : item.kind === "moment" ? item.content || video?.title || "查看动态" : "查看当天的网站更新"}
								en={item.kind === "post" ? item.titleEn : item.kind === "moment" ? item.contentEn || video?.titleEn || "View moment" : "Read the day's site updates"}
							/>
						</span>
						{poster && (
							<span class="recent-activity-preview relative h-9 w-16 shrink-0 overflow-hidden rounded-md bg-(--btn-regular-bg) ring-1 ring-(--line-divider)" aria-hidden="true">
								<img src={url(poster.src)} alt="" width="64" height="36" class="block size-full object-cover" loading="lazy" decoding="async" />
								<span class="absolute right-0.5 bottom-0.5 grid size-4 place-items-center rounded bg-black/75 text-white">
									<Icon is:inline name="material-symbols:play-arrow-rounded" class="size-3.5" />
								</span>
							</span>
						)}
					</a>
				</li>
			);
		})}
	</ol>
	<a
		href={url("/activity/")}
		class="btn-regular inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--primary)"
	>
		<LocalizedText zh="查看完整时间线" en="View full timeline" />
		<Icon is:inline name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
	</a>
</WidgetLayout>
