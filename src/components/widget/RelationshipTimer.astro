---
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import LocalizedText from "@/components/common/LocalizedText.astro";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { relationshipConfig } from "@/config";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const config = relationshipConfig;
const showTitle = widgetConfig?.showTitle !== false;
const widgetId = `relationship-${Math.random().toString(36).slice(2, 9)}`;
const frozenDuration = config.frozenDuration;
const showDaysUnit = !config.frozen || frozenDuration?.days !== undefined;
const rightAvatarBlur = Math.max(0, config.people[1].avatarBlur ?? 0);

const getInitial = (name: string): string =>
	Array.from(name.trim()).at(0) || "?";
---

<WidgetLayout
	id={widgetId}
	name={config.title || "恋爱计时"}
	nameEn={config.titleEn || "Relationship Timer"}
	showTitle={showTitle}
	class={className}
	style={style}
>
	<relationship-timer
		data-start-at={config.startAt}
		data-frozen={config.frozen ? "true" : undefined}
		data-heart={config.heart || "❤️"}
		class="block"
	>
		<div class="flex flex-col items-center p-2">
			<div class="mb-4 flex items-center justify-center gap-2 text-sm font-medium text-neutral-600 dark:text-neutral-400">
				<span>{config.people[0].name}</span>
				<span class="text-red-500 motion-safe:animate-pulse" aria-hidden="true">
					{config.heart || "❤️"}
				</span>
				<span>{config.people[1].name}</span>
			</div>

			<div class="mb-6 flex items-center justify-center gap-4">
				{
					config.people[0].avatar ? (
						<ImageWrapper
							src={config.people[0].avatar}
							alt={config.people[0].avatarAlt || config.people[0].name}
							class="h-16 w-16 rounded-full border-2 border-white shadow-md transition-transform hover:scale-110 dark:border-neutral-800"
							widths={[64, 128]}
							sizes="64px"
						/>
					) : (
						<div
							class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-white bg-neutral-100 text-xl font-bold text-(--primary) shadow-md dark:border-neutral-800 dark:bg-neutral-800"
							aria-label={config.people[0].name}
						>
							{getInitial(config.people[0].name)}
						</div>
					)
				}
				<div class="relative flex h-16 w-10 items-center justify-center">
					<div
						class="pointer-events-none absolute left-1/2 top-1/2 z-20 h-0 w-0 -translate-x-1/2 -translate-y-1/2 overflow-visible"
						data-heart-burst-layer
						aria-hidden="true"
					></div>
					<button
						type="button"
						class="relative z-10 flex h-10 w-10 touch-manipulation select-none items-center justify-center rounded-full text-2xl text-red-500 transition-transform duration-150 active:scale-90 motion-safe:hover:rotate-6 motion-safe:hover:scale-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--primary)"
						data-heart-trigger
						data-i18n-zh="点击爱心"
						data-i18n-en="Tap the heart"
						data-i18n-attr="aria-label"
						aria-label="点击爱心"
					>
						<span class="pointer-events-none drop-shadow-sm" aria-hidden="true">
							{config.heart || "❤️"}
						</span>
					</button>
				</div>
				{
					config.people[1].avatar ? (
						<div class="relative h-16 w-16 overflow-hidden rounded-full border-2 border-white shadow-md dark:border-neutral-800">
							<div
								class="h-full w-full"
								style={`filter: blur(${rightAvatarBlur}px); transform: scale(${rightAvatarBlur > 0 ? 1.2 : 1});`}
							>
								<ImageWrapper
									src={config.people[1].avatar}
									alt={config.people[1].avatarAlt || config.people[1].name}
									class="h-full w-full"
									widths={[64, 128]}
									sizes="64px"
								/>
							</div>
							<span
								class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center text-lg font-black text-(--primary) drop-shadow-sm"
								aria-hidden="true"
							>
								<LocalizedText zh="/" en="/" />
							</span>
						</div>
					) : (
						<div
							class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-white bg-neutral-100 text-xl font-bold text-(--primary) shadow-md dark:border-neutral-800 dark:bg-neutral-800"
							aria-label={config.people[1].name}
						>
							{getInitial(config.people[1].name)}
						</div>
					)
				}
			</div>

			<div
				class="flex max-w-full items-center justify-center gap-x-1 overflow-x-auto whitespace-nowrap py-1 text-sm"
				role="timer"
				aria-label="相伴时间"
				aria-live="off"
			>
				<span class="min-w-0 text-center font-bold tabular-nums text-(--primary)" data-timer-unit="years">{config.frozen ? frozenDuration?.years ?? 99 : 0}</span>
				<span class="shrink-0 rounded bg-red-400 px-1 py-0.5 text-[10px] font-medium text-white"><LocalizedText zh="年" en="yr" /></span>
				<span class="min-w-0 text-center font-bold tabular-nums text-(--primary)" data-timer-unit="months">{config.frozen ? frozenDuration?.months ?? 99 : 0}</span>
				<span class="shrink-0 rounded bg-red-300 px-1 py-0.5 text-[10px] font-medium text-white"><LocalizedText zh="月" en="mo" /></span>
				{showDaysUnit && (
					<>
						<span class="min-w-0 text-center font-bold tabular-nums text-(--primary)" data-timer-unit="days">{config.frozen ? frozenDuration?.days ?? 99 : 0}</span>
						<span class="shrink-0 rounded bg-blue-400 px-1 py-0.5 text-[10px] font-medium text-white"><LocalizedText zh="天" en="d" /></span>
					</>
				)}
				<span class="min-w-0 text-center font-bold tabular-nums text-(--primary)" data-timer-unit="hours">{config.frozen ? frozenDuration?.hours ?? 99 : 0}</span>
				<span class="shrink-0 rounded bg-orange-400 px-1 py-0.5 text-[10px] font-medium text-white"><LocalizedText zh="时" en="hr" /></span>
				<span class="min-w-0 text-center font-bold tabular-nums text-(--primary)" data-timer-unit="minutes">{config.frozen ? frozenDuration?.minutes ?? 99 : 0}</span>
				<span class="shrink-0 rounded bg-blue-500 px-1 py-0.5 text-[10px] font-medium text-white"><LocalizedText zh="分" en="min" /></span>
				<span class="min-w-0 text-center font-bold tabular-nums text-(--primary)" data-timer-unit="seconds">{config.frozen ? frozenDuration?.seconds ?? 99 : "00"}</span>
				<span class="shrink-0 rounded bg-purple-400 px-1 py-0.5 text-[10px] font-medium text-white"><LocalizedText zh="秒" en="sec" /></span>
			</div>
			<span class="sr-only" data-timer-status></span>
		</div>
	</relationship-timer>
</WidgetLayout>

<script>
	type DurationParts = {
		years: number;
		months: number;
		days: number;
		hours: number;
		minutes: number;
		seconds: number;
	};

	const EMPTY_DURATION: DurationParts = {
		years: 0,
		months: 0,
		days: 0,
		hours: 0,
		minutes: 0,
		seconds: 0,
	};

	const daysInMonth = (year: number, month: number): number =>
		new Date(year, month + 1, 0).getDate();

	const addYears = (date: Date, years: number): Date => {
		const result = new Date(date);
		const month = result.getMonth();
		const day = result.getDate();
		const targetYear = result.getFullYear() + years;
		result.setDate(1);
		result.setFullYear(targetYear);
		result.setMonth(month);
		result.setDate(Math.min(day, daysInMonth(targetYear, month)));
		return result;
	};

	const addMonths = (date: Date, months: number): Date => {
		const result = new Date(date);
		const day = result.getDate();
		const targetMonthIndex = result.getFullYear() * 12 + result.getMonth() + months;
		const targetYear = Math.floor(targetMonthIndex / 12);
		const targetMonth = ((targetMonthIndex % 12) + 12) % 12;
		result.setDate(1);
		result.setFullYear(targetYear);
		result.setMonth(targetMonth);
		result.setDate(Math.min(day, daysInMonth(targetYear, targetMonth)));
		return result;
	};

	const addDays = (date: Date, days: number): Date => {
		const result = new Date(date);
		result.setDate(result.getDate() + days);
		return result;
	};

	const getDuration = (start: Date, now: Date): DurationParts => {
		if (now.getTime() < start.getTime()) return EMPTY_DURATION;

		let years = now.getFullYear() - start.getFullYear();
		if (addYears(start, years).getTime() > now.getTime()) years -= 1;

		let cursor = addYears(start, Math.max(0, years));
		let months =
			(now.getFullYear() - cursor.getFullYear()) * 12 +
			(now.getMonth() - cursor.getMonth());
		if (addMonths(cursor, months).getTime() > now.getTime()) months -= 1;
		months = Math.max(0, months);
		cursor = addMonths(cursor, months);

		let days = Math.floor(
			(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) -
				Date.UTC(cursor.getFullYear(), cursor.getMonth(), cursor.getDate())) /
				86_400_000,
		);
		if (addDays(cursor, days).getTime() > now.getTime()) days -= 1;
		days = Math.max(0, days);
		cursor = addDays(cursor, days);

		let remaining = Math.max(0, now.getTime() - cursor.getTime());
		const hours = Math.floor(remaining / 3_600_000);
		remaining %= 3_600_000;
		const minutes = Math.floor(remaining / 60_000);
		remaining %= 60_000;
		const seconds = Math.floor(remaining / 1000);

		return { years: Math.max(0, years), months, days, hours, minutes, seconds };
	};

	class RelationshipTimerElement extends HTMLElement {
		private static readonly MAX_FLOATING_HEARTS = 28;
		private timeoutId?: number;
		private heartInteractionReady = false;
		private heartButtonAnimation?: Animation;

		private readonly handleHeartClick = (event: MouseEvent): void => {
			const target = event.target;
			if (!(target instanceof Element)) return;

			const trigger = target.closest<HTMLElement>("[data-heart-trigger]");
			if (!trigger || !this.contains(trigger)) return;
			this.releaseHeart(trigger);
		};

		connectedCallback(): void {
			if (!this.heartInteractionReady) {
				this.addEventListener("click", this.handleHeartClick);
				this.heartInteractionReady = true;
			}
			if (this.timeoutId !== undefined) return;
			if (this.dataset.frozen === "true") {
				const status = this.querySelector<HTMLElement>("[data-timer-status]");
				if (status) status.textContent = "计时已暂停";
				return;
			}
			this.update();
			this.scheduleNextTick();
		}

		disconnectedCallback(): void {
			if (this.timeoutId !== undefined) window.clearTimeout(this.timeoutId);
			this.timeoutId = undefined;
			if (this.heartInteractionReady) {
				this.removeEventListener("click", this.handleHeartClick);
				this.heartInteractionReady = false;
			}
			this.heartButtonAnimation?.cancel();
			this.heartButtonAnimation = undefined;
			this.querySelectorAll<HTMLElement>("[data-floating-heart]").forEach(
				(heart) => {
					heart.getAnimations().forEach((animation) => animation.cancel());
					heart.remove();
				},
			);
		}

		private releaseHeart(trigger: HTMLElement): void {
			const layer = this.querySelector<HTMLElement>("[data-heart-burst-layer]");
			if (!layer) return;

			const existingHearts = layer.querySelectorAll<HTMLElement>(
				"[data-floating-heart]",
			);
			if (existingHearts.length >= RelationshipTimerElement.MAX_FLOATING_HEARTS) {
				existingHearts[0].getAnimations().forEach((animation) => animation.cancel());
				existingHearts[0].remove();
			}

			const prefersReducedMotion = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;
			const floatingHeart = document.createElement("span");
			floatingHeart.dataset.floatingHeart = "true";
			floatingHeart.className =
				"pointer-events-none absolute left-0 top-0 select-none text-xl leading-none drop-shadow-sm";
			floatingHeart.style.willChange = "transform, opacity";
			floatingHeart.textContent = this.dataset.heart || "❤️";
			layer.appendChild(floatingHeart);

			const drift = prefersReducedMotion ? 0 : Math.round((Math.random() - 0.5) * 56);
			const rise = prefersReducedMotion ? 18 : Math.round(68 + Math.random() * 34);
			const rotation = prefersReducedMotion
				? 0
				: Math.round((Math.random() - 0.5) * 34);
			const duration = prefersReducedMotion
				? 260
				: Math.round(900 + Math.random() * 420);
			const origin = "translate3d(-50%, -50%, 0)";
			const heartAnimation = floatingHeart.animate(
				[
					{
						opacity: 0,
						transform: `${origin} translate3d(0, 6px, 0) scale(0.55) rotate(${-rotation}deg)`,
					},
					{
						offset: 0.16,
						opacity: 1,
						transform: `${origin} translate3d(${Math.round(drift * 0.12)}px, -10px, 0) scale(1.14) rotate(0deg)`,
					},
					{
						offset: 0.62,
						opacity: 0.9,
						transform: `${origin} translate3d(${Math.round(drift * 0.62)}px, -${Math.round(rise * 0.58)}px, 0) scale(1) rotate(${Math.round(rotation * 0.6)}deg)`,
					},
					{
						opacity: 0,
						transform: `${origin} translate3d(${drift}px, -${rise}px, 0) scale(0.78) rotate(${rotation}deg)`,
					},
				],
				{
					duration,
					easing: "cubic-bezier(0.22, 0.78, 0.26, 1)",
					fill: "forwards",
				},
			);
			const removeFloatingHeart = (): void => floatingHeart.remove();
			heartAnimation.addEventListener("finish", removeFloatingHeart, { once: true });
			heartAnimation.addEventListener("cancel", removeFloatingHeart, { once: true });

			this.heartButtonAnimation?.cancel();
			if (!prefersReducedMotion) {
				this.heartButtonAnimation = trigger.animate(
					[
						{ transform: "scale(1)" },
						{ transform: "scale(0.82)", offset: 0.28 },
						{ transform: "scale(1.18)", offset: 0.62 },
						{ transform: "scale(1)" },
					],
					{
						duration: 280,
						easing: "cubic-bezier(0.34, 1.56, 0.64, 1)",
					},
				);
			}
		}

		private scheduleNextTick(): void {
			const delay = 1000 - (Date.now() % 1000) + 20;
			this.timeoutId = window.setTimeout(() => {
				this.update();
				this.scheduleNextTick();
			}, delay);
		}

		private update(): void {
			const rawStartAt = this.dataset.startAt || "";
			const startTimestamp = Date.parse(rawStartAt);
			const status = this.querySelector<HTMLElement>("[data-timer-status]");

			if (!Number.isFinite(startTimestamp)) {
				this.renderInvalid();
				if (status) status.textContent = "开始时间配置无效";
				return;
			}

			const start = new Date(startTimestamp);
			const now = new Date();
			const isPending = now.getTime() < start.getTime();
			this.render(getDuration(start, now));
			if (status) status.textContent = isPending ? "计时尚未开始" : "计时正常";
		}

		private render(values: DurationParts): void {
			(Object.entries(values) as [keyof DurationParts, number][]).forEach(
				([unit, value]) => {
					const element = this.querySelector<HTMLElement>(
						`[data-timer-unit="${unit}"]`,
					);
					if (element) {
						element.textContent =
							unit === "seconds" ? value.toString().padStart(2, "0") : value.toString();
					}
				},
			);
		}

		private renderInvalid(): void {
			this.querySelectorAll<HTMLElement>("[data-timer-unit]").forEach((element) => {
				element.textContent = "—";
			});
		}
	}

	if (!customElements.get("relationship-timer")) {
		customElements.define("relationship-timer", RelationshipTimerElement);
	}
</script>
