---
import { visitorWidgetsConfig } from "@/config/visitorWidgetsConfig";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style } = Astro.props;
const { birthday, festivals } = visitorWidgetsConfig.festivalCountdown;
---

<festival-countdown-widget
	class:list={["block card-base p-4", className]}
	style={style}
	data-festivals={JSON.stringify(festivals)}
	data-birthday-month={birthday.month}
	data-birthday-day={birthday.day}
>
	<div class="space-y-3" aria-label="时间进度">
		<div class="grid grid-cols-[3.4rem_1fr] items-center gap-3" data-birthday-progress>
			<strong class="text-sm text-(--primary)" data-birthday-percent>--%</strong>
			<div>
				<div class="mb-1 text-sm font-medium text-neutral-700 dark:text-neutral-200">
					<span data-birthday-prefix>距离我的生日还剩</span>
					<span data-birthday-days>--</span>
					<span data-birthday-unit>天</span>
				</div>
				<div class="h-2 overflow-hidden rounded-full bg-neutral-200 dark:bg-neutral-700">
					<div class="h-full rounded-full bg-(--primary) transition-[width] duration-500" data-birthday-bar style="width: 0%"></div>
				</div>
			</div>
		</div>
		{["year", "month", "week"].map((range) => (
			<div class="grid grid-cols-[3.4rem_1fr] items-center gap-3" data-progress-range={range}>
				<strong class="text-sm text-(--primary)" data-progress-percent>--%</strong>
				<div>
					<div class="mb-1 text-sm font-medium text-neutral-700 dark:text-neutral-200" data-progress-label>正在计算…</div>
					<div class="h-2 overflow-hidden rounded-full bg-neutral-200 dark:bg-neutral-700">
						<div class="h-full rounded-full bg-(--primary) transition-[width] duration-500" data-progress-bar style="width: 0%"></div>
					</div>
				</div>
			</div>
		))}
	</div>
	<div class="my-4 border-t border-neutral-200 dark:border-neutral-700"></div>
	<div class="text-center">
		<p class="font-semibold text-neutral-700 dark:text-neutral-200" data-festival-label>距离下一个节日</p>
		<strong class="my-1 block text-4xl text-(--primary)" data-festival-days>--</strong>
		<time class="text-xs text-neutral-500 dark:text-neutral-400" data-festival-date>----/--/--</time>
	</div>
</festival-countdown-widget>

<script>
	type FestivalRule = {
		name: string;
		nameEn: string;
		calendar: "gregorian" | "chinese";
		month: number;
		day: number;
	};

	type ProgressRange = "year" | "month" | "week";

	type ProgressData = {
		percent: number;
		remainingDays: number;
		label: string;
	};

	const DAY_MS = 86400000;

	function clampPercent(value: number) {
		return Math.min(100, Math.max(0, value));
	}

	function getRemainingFullDays(now: Date, end: Date) {
		const todayUtc = Date.UTC(
			now.getFullYear(),
			now.getMonth(),
			now.getDate(),
		);
		const endUtc = Date.UTC(
			end.getFullYear(),
			end.getMonth(),
			end.getDate(),
		);
		return Math.max(0, Math.round((endUtc - todayUtc) / DAY_MS) - 1);
	}

	function buildProgressData(now: Date, english: boolean): Record<ProgressRange, ProgressData> {
		const yearStart = new Date(now.getFullYear(), 0, 1);
		const nextYear = new Date(now.getFullYear() + 1, 0, 1);
		const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
		const nextMonth = new Date(now.getFullYear(), now.getMonth() + 1, 1);
		const mondayOffset = (now.getDay() + 6) % 7;
		const weekStart = new Date(
			now.getFullYear(),
			now.getMonth(),
			now.getDate() - mondayOffset,
		);
		const nextWeek = new Date(
			weekStart.getFullYear(),
			weekStart.getMonth(),
			weekStart.getDate() + 7,
		);

		const calculate = (start: Date, end: Date, label: string): ProgressData => ({
			percent: clampPercent(((now.getTime() - start.getTime()) / (end.getTime() - start.getTime())) * 100),
			remainingDays: getRemainingFullDays(now, end),
			label,
		});

		return {
			year: calculate(yearStart, nextYear, english ? "Left this year:" : "本年还剩"),
			month: calculate(monthStart, nextMonth, english ? "Left this month:" : "本月还剩"),
			week: calculate(weekStart, nextWeek, english ? "Left this week:" : "本周还剩"),
		};
	}

	function getBirthdayProgress(now: Date, month: number, day: number) {
		const todayUtc = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
		let birthdayYear = now.getFullYear();
		let birthdayUtc = Date.UTC(birthdayYear, month - 1, day);
		if (birthdayUtc < todayUtc) {
			birthdayYear += 1;
			birthdayUtc = Date.UTC(birthdayYear, month - 1, day);
		}
		const previousBirthdayUtc = Date.UTC(birthdayYear - 1, month - 1, day);
		return {
			percent: clampPercent(
				((todayUtc - previousBirthdayUtc) /
					(birthdayUtc - previousBirthdayUtc)) *
					100,
			),
			remainingDays: Math.round((birthdayUtc - todayUtc) / DAY_MS),
		};
	}

	function getChineseMonthDay(
		date: Date,
		formatter: Intl.DateTimeFormat | null,
	): { month: number; day: number } | null {
		if (!formatter) return null;
		const parts = formatter.formatToParts(date);
		const month = Number(parts.find((part) => part.type === "month")?.value);
		const day = Number(parts.find((part) => part.type === "day")?.value);
		return Number.isFinite(month) && Number.isFinite(day) ? { month, day } : null;
	}

	function findNextFestival(now: Date, festivals: FestivalRule[]) {
		let chineseFormatter: Intl.DateTimeFormat | null = null;
		try {
			chineseFormatter = new Intl.DateTimeFormat("zh-CN-u-ca-chinese", {
				month: "numeric",
				day: "numeric",
			});
		} catch {
			chineseFormatter = null;
		}

		for (let offset = 0; offset <= 400; offset += 1) {
			const date = new Date(
				now.getFullYear(),
				now.getMonth(),
				now.getDate() + offset,
				12,
			);
			const chineseDate = getChineseMonthDay(date, chineseFormatter);
			const festival = festivals.find((item) => {
				if (item.calendar === "gregorian") {
					return date.getMonth() + 1 === item.month && date.getDate() === item.day;
				}
				return chineseDate?.month === item.month && chineseDate.day === item.day;
			});
			if (festival) return { festival, date, days: offset };
		}
		return null;
	}

	function formatDate(date: Date) {
		return [
			date.getFullYear(),
			String(date.getMonth() + 1).padStart(2, "0"),
			String(date.getDate()).padStart(2, "0"),
		].join("-");
	}

	class FestivalCountdownWidget extends HTMLElement {
		private timer: number | undefined;
		private festivals: FestivalRule[] = [];
		private readonly handleLanguageChange = () => this.update();

		connectedCallback() {
			try {
				this.festivals = JSON.parse(this.dataset.festivals || "[]");
			} catch {
				this.festivals = [];
			}
			this.update();
			document.addEventListener("firefly:language-change", this.handleLanguageChange);
			this.timer = window.setInterval(() => this.update(), 60000);
		}

		disconnectedCallback() {
			if (this.timer !== undefined) window.clearInterval(this.timer);
			document.removeEventListener("firefly:language-change", this.handleLanguageChange);
		}

		private update() {
			const now = new Date();
			const english = document.documentElement.dataset.language === "en";
			const birthdayMonth = Number(this.dataset.birthdayMonth);
			const birthdayDay = Number(this.dataset.birthdayDay);
			const birthdayDays = this.querySelector<HTMLElement>("[data-birthday-days]");
			const birthdayPercent = this.querySelector<HTMLElement>("[data-birthday-percent]");
			const birthdayBar = this.querySelector<HTMLElement>("[data-birthday-bar]");
			const birthdayPrefix = this.querySelector<HTMLElement>("[data-birthday-prefix]");
			const birthdayUnit = this.querySelector<HTMLElement>("[data-birthday-unit]");
			if (
				birthdayDays &&
				Number.isInteger(birthdayMonth) &&
				birthdayMonth >= 1 &&
				birthdayMonth <= 12 &&
				Number.isInteger(birthdayDay) &&
				birthdayDay >= 1 &&
				birthdayDay <= 31
			) {
				const birthdayProgress = getBirthdayProgress(
					now,
					birthdayMonth,
					birthdayDay,
				);
				birthdayDays.textContent = String(birthdayProgress.remainingDays);
				if (birthdayPercent) {
					birthdayPercent.textContent = `${birthdayProgress.percent.toFixed(1)}%`;
				}
				if (birthdayBar) birthdayBar.style.width = `${birthdayProgress.percent}%`;
			}
			if (birthdayPrefix) {
				birthdayPrefix.textContent = english
					? "My birthday is in"
					: "距离我的生日还剩";
			}
			if (birthdayUnit) birthdayUnit.textContent = english ? "days" : "天";
			const progress = buildProgressData(now, english);
			this.querySelectorAll<HTMLElement>("[data-progress-range]").forEach((row) => {
				const range = row.dataset.progressRange as ProgressRange;
				const data = progress[range];
				if (!data) return;
				const percent = row.querySelector<HTMLElement>("[data-progress-percent]");
				const label = row.querySelector<HTMLElement>("[data-progress-label]");
				const bar = row.querySelector<HTMLElement>("[data-progress-bar]");
				if (percent) percent.textContent = `${data.percent.toFixed(1)}%`;
				if (label) label.textContent = english
					? `${data.label} ${data.remainingDays} days`
					: `${data.label} ${data.remainingDays} 天`;
				if (bar) bar.style.width = `${data.percent}%`;
			});

			const next = findNextFestival(now, this.festivals);
			if (!next) return;
			const label = this.querySelector<HTMLElement>("[data-festival-label]");
			const days = this.querySelector<HTMLElement>("[data-festival-days]");
			const date = this.querySelector<HTMLTimeElement>("[data-festival-date]");
			if (label) {
				const festivalName = english ? next.festival.nameEn : next.festival.name;
				label.textContent = next.days === 0
					? english ? `Today is ${festivalName}` : `今天是${festivalName}`
					: english ? `Until ${festivalName}` : `距离${festivalName}`;
			}
			if (days) days.textContent = String(next.days);
			if (date) {
				const value = formatDate(next.date);
				date.textContent = value;
				date.dateTime = value;
			}
		}
	}

	if (!customElements.get("festival-countdown-widget")) {
		customElements.define(
			"festival-countdown-widget",
			FestivalCountdownWidget,
		);
	}
</script>
