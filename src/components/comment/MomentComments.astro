---
import { Icon } from "astro-icon/components";
import LocalizedText from "@/components/common/LocalizedText.astro";
import { url } from "@/utils/url-utils";

interface Props {
	id: string;
}
const { id } = Astro.props;
---
<moment-comments data-frame-url={url(`/moment-comments/${id}/`)}>
 <details>
  <summary><Icon is:inline name="material-symbols:forum-outline-rounded" aria-hidden="true" /><span class="when-closed"><LocalizedText zh="展开评论" en="Show comments" /></span><span class="when-open"><LocalizedText zh="收起评论" en="Hide comments" /></span><span class="comment-chevron" aria-hidden="true">⌄</span></summary>
  <div class="moment-comments-body">
   <p data-comment-loading role="status"><LocalizedText zh="正在加载评论…" en="Loading comments…" /></p>
   <div data-comment-frame-mount></div>
   <noscript><a href={url(`/moment-comments/${id}/`)}>打开评论</a></noscript>
  </div>
 </details>
</moment-comments>
<script>
 import { registerMomentComments } from "@/utils/moment-comments";
 registerMomentComments();
</script>
<style>
 moment-comments { display: block; margin-top: 1rem; border-top: 1px dashed var(--line-divider); padding-top: .8rem; }
 summary { display: inline-flex; align-items: center; gap: .45rem; list-style: none; border-radius: .6rem; padding: .45rem .7rem; color: var(--btn-content); background: var(--btn-regular-bg); font-size: .8rem; cursor: pointer; user-select: none; }
 summary::-webkit-details-marker { display: none; }
 summary:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
 .when-open, details[open] .when-closed { display: none; } details[open] .when-open { display: inline; }
 .comment-chevron { transition: transform 200ms ease; } details[open] .comment-chevron { transform: rotate(180deg); }
 .moment-comments-body { padding-top: .8rem; min-width: 0; }
 [data-comment-loading] { color: var(--content-meta); font-size: .8rem; padding: .6rem 0; }
 [data-comment-loading][hidden] { display: none; }
 moment-comments :global(iframe[data-moment-comment-frame]) { width: 100%; min-height: 180px; border: 0; display: block; background: transparent; color-scheme: normal; }
 @media(prefers-reduced-motion:reduce) { .comment-chevron { transition: none; } }
</style>
