---
interface Props {
	size?: string;
	dot?: boolean;
	href?: string;
	label?: string;
	count?: number;
}
const { dot, href, label, count }: Props = Astro.props;
---
<a href={href} aria-label={label} class:list={[count !== undefined && "inline-flex items-center gap-2", "transition text-sm font-medium px-3 py-1.5 rounded-full bg-black/5 dark:bg-white/10 text-neutral-500 dark:text-neutral-400 hover:bg-(--btn-regular-bg) hover:text-(--btn-content)"]}>
    {dot && <div class="h-1 w-1 bg-(--btn-content) dark:bg-(--card-bg) transition rounded-md mr-2"></div>}
    <slot></slot>
    {count !== undefined && <span class="sidebar-count-pill inline-flex min-w-5 items-center justify-center rounded-full px-1.5 py-0.5 text-[0.65rem] leading-none" data-i18n-skip>{count}</span>}
</a>
