---
import { Icon } from "astro-icon/components";

interface Props {
	title: string;
	description: string;
	titleEn?: string;
	descriptionEn?: string;
	icon: string;
}

import LocalizedText from "@/components/common/LocalizedText.astro";

const {
	title,
	description,
	titleEn = title,
	descriptionEn = description,
	icon,
} = Astro.props;
---

<header class="mb-7">
	<div class="mb-3 flex items-center gap-3">
		<div
			class="flex h-9 w-9 items-center justify-center rounded-xl bg-(--primary) text-white shadow-sm dark:text-black/70"
		>
			<Icon is:inline name={icon} class="text-[1.55rem]" />
		</div>
		<h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
			<LocalizedText zh={title} en={titleEn} />
		</h1>
	</div>
	<p class="text-base leading-relaxed text-neutral-600 dark:text-neutral-400">
		<LocalizedText zh={description} en={descriptionEn} />
	</p>
</header>
