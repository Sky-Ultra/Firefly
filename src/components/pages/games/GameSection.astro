---
import { Icon } from "astro-icon/components";
import LocalizedText from "@/components/common/LocalizedText.astro";
import type { GameCategory } from "@/types/gameConfig";
import GameCard from "./GameCard.astro";

interface Props {
	category: GameCategory;
}

const { category } = Astro.props;
const headingId = `game-category-${category.id}`;
---

<section class="game-section" aria-labelledby={headingId}>
	<div class="mb-5 flex items-center justify-between gap-4">
		<div class="flex min-w-0 items-center gap-3">
			<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-(--primary)/10 text-(--primary)">
				<Icon is:inline name={category.icon} class="text-[1.4rem]" />
			</div>
			<div class="min-w-0">
				<h2 id={headingId} class="text-xl font-bold text-neutral-900 dark:text-neutral-100">
					<LocalizedText zh={category.name} en={category.nameEn ?? category.name} />
				</h2>
				<p class="truncate text-sm text-neutral-500 dark:text-neutral-400">
					<LocalizedText zh={category.description} en={category.descriptionEn ?? category.description} />
				</p>
			</div>
		</div>
		<span class="shrink-0 rounded-full bg-(--primary)/10 px-3 py-1 text-xs font-medium text-(--primary)">
			{category.items.length} <LocalizedText zh="项" en="games" />
		</span>
	</div>

	<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4">
		{
			category.items.map((item, index) => (
				<GameCard item={item} index={index} />
			))
		}
	</div>

	{
		category.trailingEllipsis && (
			<div class="mt-5 text-center">
				<div class="flex items-center justify-center gap-2 text-(--primary)" aria-hidden="true">
					<span class="h-1.5 w-1.5 rounded-full bg-current opacity-45" />
					<span class="h-1.5 w-1.5 rounded-full bg-current opacity-70" />
					<span class="h-1.5 w-1.5 rounded-full bg-current" />
				</div>
				<p class="mt-2 text-sm text-(--primary)"><LocalizedText zh="我的旅途未完待续" en="My journey continues" /></p>
			</div>
		)
	}
</section>
