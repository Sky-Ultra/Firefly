---
import "@/styles/fairytale-layout.css";
import "@/styles/fairytale-menus.css";
import FairytaleParallax from "./FairytaleParallax.astro";
---
<fairytale-layout id="fairytale-backdrop" data-fairytale-cached-blur aria-hidden="true" hidden>
 <FairytaleParallax>
 <img data-fairytale-image alt="" decoding="async" />
 <img data-fairytale-image alt="" decoding="async" />
 <div class="fairytale-soft-layer">
  <img data-fairytale-soft-image alt="" decoding="async" />
  <img data-fairytale-soft-image alt="" decoding="async" />
 </div>
 </FairytaleParallax>
</fairytale-layout>
<script>
 import { mountFairytaleLayout } from "@/utils/fairytale-layout";
 class FairytaleLayout extends HTMLElement {
  private dispose?: () => void;
  connectedCallback() { queueMicrotask(() => { if (this.isConnected && !this.dispose) this.dispose = mountFairytaleLayout(this); }); }
  disconnectedCallback() { this.dispose?.(); this.dispose = undefined; }
 }
 if (!customElements.get("fairytale-layout")) customElements.define("fairytale-layout",FairytaleLayout);
</script>
