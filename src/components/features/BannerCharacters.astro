---
import DraggableSticker from "@/components/common/DraggableSticker.astro";

// Artwork from Aemeath's public character assets; see LICENSES/Aemeath.txt.
const characters = [
	["loading-girl", "桌前的小人"],
	["blue-witch", "蓝色魔女"],
	["white-haired-reader", "白发小人"],
	["pink-uniform", "粉色制服小人"],
	["bamboo-girl", "竹筒小人"],
	["aqua-singer", "蓝绿歌姬"],
	["pink-bows", "粉色蝴蝶结小人"],
	["brown-lightning", "棕发小人"],
	["pink-cat", "粉色猫耳小人"],
];
---

<div class="banner-characters" data-drag-boundary data-pagefind-ignore="all">
	<div class="banner-characters-row">
		{characters.map(([name, label]) => <DraggableSticker src={`/images/characters/${name}.webp`} label={label} />)}
	</div>
</div>

<style>
	.banner-characters { position: absolute; inset: 4.5rem 0 0; z-index: 25; pointer-events: none; }
	:global(body:not(.is-home)) .banner-characters { visibility: hidden; }
	.banner-characters-row {
		position: absolute; bottom: 2.1rem; left: 50%; transform: translateX(-50%);
		display: flex; align-items: end; justify-content: space-around; gap: 1.2rem;
		width: min(92%, 100rem); --sticker-size: clamp(4rem, 7vw, 8rem);
	}
	@media (max-width: 639px) {
		.banner-characters-row { bottom: 1rem; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.4rem; width: 94%; --sticker-size: clamp(2.9rem, 14vw, 4rem); }
	}
</style>
