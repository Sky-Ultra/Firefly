---
import { musicPlayerConfig } from "@/config/musicConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { url } from "@/utils/url-utils";

const config = musicPlayerConfig;

const localPlaylist =
	config.mode === "local" && config.local?.playlist
		? config.local.playlist.map((song) => {
				const isFullUrl = (path: string) => /^https?:\/\//.test(path);
				return {
					name: song.name,
					artist: song.artist,
					url: isFullUrl(song.url) ? song.url : url(song.url),
					pic: song.cover
						? isFullUrl(song.cover)
							? song.cover
							: url(song.cover)
						: undefined,
					lrc: song.lrc
						? isFullUrl(song.lrc)
							? song.lrc
							: url(song.lrc)
						: undefined,
				};
			})
		: [];

const managerConfigStr = JSON.stringify({
	mode: config.mode,
	meting: config.meting,
	localPlaylist: localPlaylist,
	volume: config.volume ?? 0.7,
	playMode: config.playMode ?? "list",
	showLyrics: config.showLyrics ?? true,
	i18n: {
		noPlaying: i18n(I18nKey.musicNoPlaying),
		lyrics: i18n(I18nKey.musicLyrics),
		volume: i18n(I18nKey.musicVolume),
		playMode: i18n(I18nKey.musicPlayMode),
		prev: i18n(I18nKey.musicPrev),
		next: i18n(I18nKey.musicNext),
		playlist: i18n(I18nKey.musicPlaylist),
		noLyrics: i18n(I18nKey.musicNoLyrics),
		loadingLyrics: i18n(I18nKey.musicLoadingLyrics),
		failedLyrics: i18n(I18nKey.musicFailedLyrics),
		noSongs: i18n(I18nKey.musicNoSongs),
		error: i18n(I18nKey.musicError),
		play: i18n(I18nKey.musicPlay),
		pause: i18n(I18nKey.musicPause),
		progress: i18n(I18nKey.musicProgress),
		noCover: i18n(I18nKey.musicNoCover),
	},
});
---

<script is:inline data-swup-ignore-script define:vars={{ managerConfigStr }}>
(function () {
    // Singleton guard – only create once
    if (window.__fireflyMusic) return;

    var config = JSON.parse(managerConfigStr);
    var PLAYBACK_MEMORY_KEY = 'firefly-music-playback-v1';
    var MEMORY_WRITE_INTERVAL_MS = 2000;

    // ── Helpers ──────────────────────────────────────────────
    function formatTime(seconds) {
        if (!seconds || isNaN(seconds)) return '0:00';
        var min = Math.floor(seconds / 60);
        var sec = Math.floor(seconds % 60);
        return min + ':' + (sec < 10 ? '0' : '') + sec;
    }

    function parseLRC(lrc) {
        if (!lrc) return [];
        var lines = lrc.split('\n');
        var result = [];
        var timeReg = /\[(\d{2}):(\d{2})\.(\d{2,3})\]/g;
        lines.forEach(function (line) {
            var matches = Array.from(line.matchAll(timeReg));
            if (matches.length > 0) {
                var text = line.replace(timeReg, '').trim();
                if (text) {
                    matches.forEach(function (match) {
                        var m = parseInt(match[1]);
                        var s = parseInt(match[2]);
                        var ms = parseInt(match[3]);
                        var time = m * 60 + s + ms / (match[3].length === 3 ? 1000 : 100);
                        result.push({ time: time, text: text });
                    });
                }
            }
        });
        return result.sort(function (a, b) { return a.time - b.time; });
    }

    function normalizeTrackIdentityPart(value) {
        return String(value || '').trim().replace(/\s+/g, ' ').toLowerCase();
    }

    function getTrackKey(track) {
        if (!track) return '';
        return normalizeTrackIdentityPart(track.name)
            + '\n'
            + normalizeTrackIdentityPart(track.artist);
    }

    function readPlaybackMemory() {
        try {
            var raw = localStorage.getItem(PLAYBACK_MEMORY_KEY);
            if (!raw) return null;

            var memory = JSON.parse(raw);
            if (!memory || memory.version !== 1 || typeof memory.trackKey !== 'string') {
                return null;
            }

            var currentTime = Number(memory.currentTime);
            return {
                trackKey: memory.trackKey,
                currentTime: Number.isFinite(currentTime) && currentTime > 0 ? currentTime : 0
            };
        } catch (e) {
            console.warn('Unable to read music playback memory:', e);
            return null;
        }
    }

    // ── Audio element (persistent, attached to body) ────────
    var audio = document.createElement('audio');
    audio.crossOrigin = 'anonymous';
    audio.preload = 'metadata';
    audio.style.display = 'none';
    document.body.appendChild(audio);

    // ── State ────────────────────────────────────────────────
    var loadVersion = 0; // incremented on each loadTrack to discard stale play() results
    var sourceAttempt = 0;
    var sourceIndex = 0;
    var sourceTimeoutId = null;
    var sourceFailureHandled = false;
    var failedTrackIndices = new Set();
    var wantPlayback = false;
    var lastMemoryWriteAt = 0;
    var pendingResume = null;
    var state = {
        playlist: [],
        currentIndex: 0,
        isPlaying: false,
        playMode: 0, // 0: list, 1: one, 2: random
        volume: localStorage.getItem('music-player-volume') !== null
            ? parseFloat(localStorage.getItem('music-player-volume'))
            : (config.volume || 0.7),
        isMuted: false,
        lyrics: [],
        currentLrcIndex: -1,
        initialized: false,
        initializing: false,
        error: null
    };

    function persistPlaybackMemory(force, timeOverride) {
        if (state.playlist.length === 0) return;

        var now = Date.now();
        if (!force && now - lastMemoryWriteAt < MEMORY_WRITE_INTERVAL_MS) return;

        var track = state.playlist[state.currentIndex];
        if (!track) return;

        var rememberedTime = Number.isFinite(timeOverride)
            ? timeOverride
            : audio.currentTime;
        if (pendingResume && pendingResume.version === loadVersion) {
            rememberedTime = pendingResume.time;
        }
        if (!Number.isFinite(rememberedTime) || rememberedTime < 0) {
            rememberedTime = 0;
        }

        try {
            localStorage.setItem(PLAYBACK_MEMORY_KEY, JSON.stringify({
                version: 1,
                trackKey: getTrackKey(track),
                currentTime: rememberedTime,
                updatedAt: now
            }));
            lastMemoryWriteAt = now;
        } catch (e) {
            console.warn('Unable to save music playback memory:', e);
        }
    }

    function scheduleResumeTime(time, version) {
        var resumeTime = Number(time);
        if (!Number.isFinite(resumeTime) || resumeTime <= 0) return;

        pendingResume = { version: version, time: resumeTime };

        function restore() {
            if (version !== loadVersion || !pendingResume) return;
            if (audio.readyState < 1 || !Number.isFinite(audio.duration)) return;

            audio.currentTime = Math.max(0, Math.min(resumeTime, audio.duration));
            pendingResume = null;
            persistPlaybackMemory(true);
        }

        if (audio.readyState >= 1) restore();
        else audio.addEventListener('loadedmetadata', restore, { once: true });
    }

    // Map config playMode string to number
    if (config.playMode === 'random') state.playMode = 2;
    else if (config.playMode === 'one') state.playMode = 1;
    else state.playMode = 0;

    // ── Event helpers ────────────────────────────────────────
    function emit(name, detail) {
        window.dispatchEvent(new CustomEvent(name, { detail: detail || {} }));
    }

    // ── Meting fetch ─────────────────────────────────────────
    function metingEndpoint(api, server, type, id) {
        return api
            .replace(':server', server)
            .replace(':type', type)
            .replace(':id', id)
            .replace(':r', Math.random());
    }

    function sourceCandidates(server, id, preferredUrl) {
        var urls = preferredUrl ? [preferredUrl] : [];
        var m = config.meting || {};
        var apis = [m.api].concat(m.fallbackApis || []);
        apis.forEach(function (api) {
            if (!api) return;
            urls.push(metingEndpoint(api, server, 'url', id));
        });
        var seen = new Set();
        return urls.filter(function (candidate) {
            var normalized = new URL(candidate);
            normalized.searchParams.delete('r');
            var key = normalized.toString();
            if (seen.has(key)) return false;
            seen.add(key);
            return true;
        });
    }

    function playlistItemSources(item, meting) {
        if (!item.url) return [];
        try {
            var parsed = new URL(item.url);
            var id = parsed.searchParams.get('id');
            var server = parsed.searchParams.get('server') || meting.server;
            if (id && parsed.searchParams.get('type') === 'url') {
                return sourceCandidates(server, id, item.url);
            }
        } catch (e) {
            // A direct or local audio URL is still a valid single source.
        }
        return [item.url];
    }

    function createConfiguredTrack(song, api) {
        function endpoint(type, id) {
            return metingEndpoint(api, song.server, type, id);
        }

        var primaryUrl = endpoint('url', song.id);
        return {
            name: song.name,
            artist: song.artist,
            url: primaryUrl,
            sources: sourceCandidates(song.server, song.id, primaryUrl),
            pic: song.picId ? endpoint('pic', song.picId) : '',
            lrc: endpoint('lrc', song.id)
        };
    }

    function applyBaseHeadOrder(baseHead, preferredNames) {
        if (!Array.isArray(preferredNames) || preferredNames.length === 0) {
            return baseHead;
        }

        var remaining = baseHead.slice();
        var preferred = preferredNames.reduce(function (tracks, preferredName) {
            var normalizedName = String(preferredName || '').trim();
            var matchIndex = remaining.findIndex(function (track) {
                return String(track.name || '').trim() === normalizedName;
            });

            if (matchIndex >= 0) {
                tracks.push(remaining.splice(matchIndex, 1)[0]);
            }

            return tracks;
        }, []);

        return preferred.concat(remaining);
    }

    function applyConfiguredPlaylistOrder(basePlaylist, meting) {
        var order = meting.playlistOrder;
        if (!order || !order.songApi) return basePlaylist;

        var headCount = Math.max(0, Math.min(
            Number(order.baseHeadCount) || 0,
            basePlaylist.length
        ));
        var pinned = (order.pinnedSongs || []).map(function (song) {
            return createConfiguredTrack(song, order.songApi);
        });
        var inserted = (order.insertedSongs || []).map(function (song) {
            return createConfiguredTrack(song, order.songApi);
        });
        var baseHead = applyBaseHeadOrder(
            basePlaylist.slice(0, headCount),
            order.baseHeadOrder
        );

        return pinned
            .concat(baseHead)
            .concat(inserted)
            .concat(basePlaylist.slice(headCount));
    }

    async function fetchJsonWithTimeout(fetchUrl, timeoutMs) {
        var controller = new AbortController();
        var timeoutId = setTimeout(function () {
            controller.abort();
        }, timeoutMs);

        try {
            var res = await fetch(fetchUrl, { signal: controller.signal });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return await res.json();
        } finally {
            clearTimeout(timeoutId);
        }
    }

    async function fetchMetingData() {
        if (!config.meting) return;
        var m = config.meting;
        var apis = [m.api].concat(m.fallbackApis || []);

        for (var i = 0; i < apis.length; i++) {
            var baseApi = apis[i];
            if (!baseApi) continue;
            try {
                var fetchUrl = baseApi
                    .replace(':server', m.server)
                    .replace(':type', m.type)
                    .replace(':id', m.id)
                    .replace(':r', Math.random());
                if (m.auth) fetchUrl += '&auth=' + m.auth;

                var data = await fetchJsonWithTimeout(
                    fetchUrl,
                    Number(m.requestTimeoutMs) || 8000
                );

                if (Array.isArray(data) && data.length > 0) {
                    var basePlaylist = data.map(function (item) {
                        return {
                            name: item.title || item.name || 'Unknown',
                            artist: item.author || item.artist || 'Unknown',
                            url: item.url,
                            sources: playlistItemSources(item, m),
                            pic: item.pic || item.cover || '',
                            lrc: item.lrc
                        };
                    });
                    state.playlist = applyConfiguredPlaylistOrder(basePlaylist, m);
                    return;
                }
            } catch (e) {
                console.warn('Meting API failed for ' + baseApi, e);
            }
        }
        throw new Error('All Meting APIs failed');
    }

    // ── Lyrics ───────────────────────────────────────────────
    function loadLyrics(track) {
        var lyricVersion = loadVersion;
        state.lyrics = [];
        state.currentLrcIndex = -1;

        if (!track.lrc) {
            emit('fm:lyrics', { lyrics: [], status: 'none' });
            return;
        }

        var isLrcUrl = /^(https?:)?\/\//.test(track.lrc)
            || track.lrc.startsWith('/')
            || /\.(lrc|txt)(\?|#|$)/i.test(track.lrc);

        if (isLrcUrl) {
            emit('fm:lyrics', { lyrics: [], status: 'loading' });
            fetch(track.lrc)
                .then(function (r) { return r.text(); })
                .then(function (text) {
                    if (lyricVersion !== loadVersion) return;
                    state.lyrics = parseLRC(text);
                    emit('fm:lyrics', { lyrics: state.lyrics, status: 'loaded' });
                })
                .catch(function () {
                    if (lyricVersion !== loadVersion) return;
                    state.lyrics = [];
                    emit('fm:lyrics', { lyrics: [], status: 'failed' });
                });
        } else {
            state.lyrics = parseLRC(track.lrc);
            emit('fm:lyrics', { lyrics: state.lyrics, status: state.lyrics.length > 0 ? 'loaded' : 'none' });
        }
    }

    // ── Track loading ────────────────────────────────────────
    function clearSourceTimeout() {
        if (sourceTimeoutId !== null) {
            clearTimeout(sourceTimeoutId);
            sourceTimeoutId = null;
        }
    }

    function armSourceTimeout(attempt) {
        clearSourceTimeout();
        sourceTimeoutId = setTimeout(function () {
            failCurrentSource(attempt);
        }, 12000);
    }

    function getSources(track) {
        if (Array.isArray(track.sources) && track.sources.length > 0) return track.sources;
        return track.url ? [track.url] : [];
    }

    function requestPlayback() {
        var ver = loadVersion;
        var attempt = sourceAttempt;
        audio.play().then(function () {
            if (ver !== loadVersion || attempt !== sourceAttempt) return;
            clearSourceTimeout();
            state.isPlaying = true;
            state.error = null;
            emit('fm:play-state', { isPlaying: true });
        }).catch(function (e) {
            if (ver !== loadVersion || attempt !== sourceAttempt) return;
            if (e.name === 'AbortError') return;
            if (e.name === 'NotAllowedError') {
                clearSourceTimeout();
                wantPlayback = false;
                state.isPlaying = false;
                emit('fm:play-state', { isPlaying: false });
                return;
            }
            failCurrentSource(attempt);
        });
    }

    function startSource(resumeTime) {
        var track = state.playlist[state.currentIndex];
        var sources = getSources(track);
        var attempt = ++sourceAttempt;
        sourceFailureHandled = false;
        clearSourceTimeout();

        if (!sources[sourceIndex]) {
            failCurrentSource(attempt);
            return;
        }

        audio.src = sources[sourceIndex];
        scheduleResumeTime(resumeTime, loadVersion);
        if (wantPlayback) armSourceTimeout(attempt);
        audio.load();
        if (wantPlayback) requestPlayback();
    }

    function failCurrentSource(attempt) {
        if (attempt !== sourceAttempt || sourceFailureHandled) return;
        var track = state.playlist[state.currentIndex];
        if (!track) return;
        sourceFailureHandled = true;
        clearSourceTimeout();
        state.isPlaying = false;
        emit('fm:play-state', { isPlaying: false });

        sourceIndex++;
        if (sourceIndex < getSources(track).length) {
            startSource(audio.currentTime);
            return;
        }

        failedTrackIndices.add(state.currentIndex);
        if (failedTrackIndices.size < state.playlist.length) {
            loadTrack(
                (state.currentIndex + 1) % state.playlist.length,
                wantPlayback,
                0,
                failedTrackIndices
            );
            return;
        }

        wantPlayback = false;
        state.error = config.i18n.error;
        emit('fm:error', { message: state.error });
    }

    function loadTrack(index, autoPlay, resumeTime, alreadyFailed) {
        if (index < 0 || index >= state.playlist.length) return;
        state.currentIndex = index;
        var track = state.playlist[index];
        ++loadVersion;
        sourceIndex = 0;
        failedTrackIndices = alreadyFailed || new Set();
        wantPlayback = !!autoPlay;
        state.error = null;
        pendingResume = null;

        loadLyrics(track);

        emit('fm:track', { index: index, track: track, autoPlay: !!autoPlay });
        var initialRememberedTime = Number(resumeTime);
        persistPlaybackMemory(
            true,
            Number.isFinite(initialRememberedTime) && initialRememberedTime > 0
                ? initialRememberedTime
                : 0
        );

        state.isPlaying = false;
        emit('fm:play-state', { isPlaying: false });
        startSource(resumeTime);
    }

    // ── Playback controls ────────────────────────────────────
    function togglePlay() {
        if (audio.paused) {
            if (state.error) {
                loadTrack(state.currentIndex, true);
                return;
            }
            wantPlayback = true;
            armSourceTimeout(sourceAttempt);
            requestPlayback();
        } else {
            wantPlayback = false;
            clearSourceTimeout();
            audio.pause();
            state.isPlaying = false;
            emit('fm:play-state', { isPlaying: false });
        }
    }

    function playNext(auto) {
        if (state.playMode === 1 && auto) {
            audio.currentTime = 0;
            wantPlayback = true;
            requestPlayback();
            return;
        }
        var nextIndex;
        if (state.playMode === 2) {
            nextIndex = Math.floor(Math.random() * state.playlist.length);
        } else {
            nextIndex = (state.currentIndex + 1) % state.playlist.length;
        }
        loadTrack(nextIndex, true);
    }

    function playPrev() {
        var prevIndex;
        if (state.playMode === 2) {
            prevIndex = Math.floor(Math.random() * state.playlist.length);
        } else {
            prevIndex = (state.currentIndex - 1 + state.playlist.length) % state.playlist.length;
        }
        loadTrack(prevIndex, true);
    }

    function setPlayMode(mode) {
        state.playMode = mode;
        emit('fm:mode', { playMode: mode });
    }

    function cyclePlayMode() {
        setPlayMode((state.playMode + 1) % 3);
    }

    function setVolume(val) {
        val = Math.max(0, Math.min(1, val));
        state.volume = val;
        state.isMuted = false;
        audio.volume = val;
        audio.muted = false;
        localStorage.setItem('music-player-volume', val.toString());
        emit('fm:volume', { volume: val, isMuted: false });
    }

    function toggleMute() {
        state.isMuted = !state.isMuted;
        audio.muted = state.isMuted;
        emit('fm:volume', { volume: state.volume, isMuted: state.isMuted });
    }

    function seek(percent) {
        if (!audio.duration) return;
        audio.currentTime = Math.max(0, Math.min(1, percent)) * audio.duration;
    }

    function seekToTime(time) {
        if (!audio.duration) return;
        audio.currentTime = Math.max(0, Math.min(time, audio.duration));
    }

    function playTrackByIndex(index) {
        if (index === state.currentIndex && !audio.paused) {
            togglePlay();
        } else {
            loadTrack(index, true);
        }
    }

    // ── Audio events → broadcast ─────────────────────────────
    audio.addEventListener('timeupdate', function () {
        if (isNaN(audio.duration)) return;
        var ct = audio.currentTime;
        var dur = audio.duration;
        var pct = (ct / dur) * 100;

        emit('fm:time', {
            currentTime: ct,
            duration: dur,
            progress: pct,
            currentTimeStr: formatTime(ct),
            durationStr: formatTime(dur)
        });

        persistPlaybackMemory(false);

        // Lyrics sync
        if (state.lyrics.length > 0) {
            var idx = -1;
            for (var i = 0; i < state.lyrics.length; i++) {
                if (ct >= state.lyrics[i].time) idx = i;
                else break;
            }
            if (idx !== state.currentLrcIndex) {
                state.currentLrcIndex = idx;
                emit('fm:lrc-index', { index: idx });
            }
        }
    });

    audio.addEventListener('ended', function () {
        playNext(true);
    });

    audio.addEventListener('playing', clearSourceTimeout);
    audio.addEventListener('waiting', function () {
        if (wantPlayback) armSourceTimeout(sourceAttempt);
    });

    audio.addEventListener('pause', function () {
        persistPlaybackMemory(true);
    });

    audio.addEventListener('seeked', function () {
        persistPlaybackMemory(true);
    });

    window.addEventListener('pagehide', function () {
        persistPlaybackMemory(true);
    });

    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden') {
            persistPlaybackMemory(true);
        }
    });

    audio.addEventListener('error', function () {
        failCurrentSource(sourceAttempt);
    });

    // ── Init (idempotent) ────────────────────────────────────
    async function init() {
        if (state.initialized || state.initializing) return;
        state.initializing = true;

        try {
            if (config.mode === 'meting' && config.meting) {
                await fetchMetingData();
            } else if (config.mode === 'local') {
                state.playlist = config.localPlaylist || [];
            }

            if (state.playlist.length > 0) {
                // Apply volume
                audio.volume = state.volume;

                var startIndex = 0;
                var resumeTime = 0;
                var playbackMemory = readPlaybackMemory();
                if (playbackMemory) {
                    var rememberedIndex = state.playlist.findIndex(function (track) {
                        return getTrackKey(track) === playbackMemory.trackKey;
                    });
                    if (rememberedIndex >= 0) {
                        startIndex = rememberedIndex;
                        resumeTime = playbackMemory.currentTime;
                    }
                } else if (state.playMode === 2) {
                    startIndex = Math.floor(Math.random() * state.playlist.length);
                }

                state.initialized = true;

                emit('fm:init', {
                    playlist: state.playlist,
                    playMode: state.playMode,
                    volume: state.volume,
                    isMuted: state.isMuted
                });

                loadTrack(startIndex, false, resumeTime);
            } else {
                state.initialized = true;
                emit('fm:init', {
                    playlist: [],
                    playMode: state.playMode,
                    volume: state.volume,
                    isMuted: state.isMuted
                });
                emit('fm:error', { message: config.i18n.noSongs });
            }
        } catch (e) {
            console.error('Music Manager init error:', e);
            state.initialized = true;
            emit('fm:init', {
                playlist: [],
                playMode: state.playMode,
                volume: state.volume,
                isMuted: state.isMuted
            });
            emit('fm:error', { message: config.i18n.error });
        } finally {
            state.initializing = false;
        }
    }

    // ── Public API ───────────────────────────────────────────
    window.__fireflyMusic = {
        init: init,
        getState: function () {
            var track = state.playlist[state.currentIndex] || null;
            return {
                playlist: state.playlist,
                currentIndex: state.currentIndex,
                track: track,
                isPlaying: state.isPlaying,
                playMode: state.playMode,
                volume: state.volume,
                isMuted: state.isMuted,
                currentTime: audio.currentTime,
                duration: audio.duration || 0,
                progress: audio.duration ? (audio.currentTime / audio.duration) * 100 : 0,
                currentTimeStr: formatTime(audio.currentTime),
                durationStr: formatTime(audio.duration),
                lyrics: state.lyrics,
                currentLrcIndex: state.currentLrcIndex,
                initialized: state.initialized,
                error: state.error,
                config: config
            };
        },
        togglePlay: togglePlay,
        playNext: function () { playNext(false); },
        playPrev: playPrev,
        cyclePlayMode: cyclePlayMode,
        setVolume: setVolume,
        toggleMute: toggleMute,
        seek: seek,
        seekToTime: seekToTime,
        playTrackByIndex: playTrackByIndex,
        loadTrack: loadTrack
    };
})();
</script>
