---
import DraggableSticker from "@/components/common/DraggableSticker.astro";
---

<div class="home-title-sticker-anchor">
	<slot />
	<DraggableSticker
		src="/images/stickers/youre-absolutely-right.png"
		label="You're Absolutely Right! 贴纸"
		class="home-title-sticker"
	/>
</div>

<style>
	.home-title-sticker-anchor {
		position: relative;
		display: inline-block;
		width: max-content;
		max-width: 100%;
	}
	.home-title-sticker-anchor :global(.home-title-sticker) {
		position: absolute;
		top: -7rem;
		right: -3rem;
		z-index: 3;
		--sticker-size: 6.5rem;
	}
	.home-title-sticker-anchor :global(.home-title-sticker img) {
		filter: none;
	}
	@media (max-width: 639px) {
		.home-title-sticker-anchor :global(.home-title-sticker) {
			top: -6rem;
			right: -2rem;
			--sticker-size: 5rem;
		}
	}
</style>
