---
import Twikoo from "@/components/comment/Twikoo.astro";
import { personalPagesConfig } from "@/config";
export function getStaticPaths() {
	return personalPagesConfig.moments.items
		.filter((item) => item.media?.type === "bilibili")
		.map((item) => ({ params: { id: item.id } }));
}
const path = `/moments/${Astro.params.id}`;
---
<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>动态评论</title></head>
 <body><Twikoo path={path} fixedPath /><noscript>请启用 JavaScript 后使用评论。</noscript></body>
</html>
<style is:global>
 :root { --primary:#e875a0; --card-bg:#fff; --card-bg-transparent:#ffffff80; --line-divider:#e5e7eb; --deep-text:#333; --content-meta:#888; --btn-content:#7c5263; --btn-regular-bg:#fceaf1; }
 html,body { margin:0; padding:0; background:transparent; font:14px/1.6 system-ui,"Microsoft YaHei",sans-serif; color:var(--deep-text); }
 body { padding:1px 2px 6px; overflow-wrap:anywhere; }
 *,*::before,*::after { box-sizing:border-box; } button,input,textarea { font-family:inherit; }
 [hidden] { display:none!important; }
 .twikoo .tk-comments-title,.twikoo .tk-comments-sort { line-height:1.6; }
 @media(max-width:480px){.twikoo .tk-avatar{width:30px;height:30px}.twikoo .tk-submit{gap:8px}.twikoo .tk-meta-input{flex-wrap:wrap;gap:6px}.twikoo .tk-meta-input .el-input{flex:0 0 auto;width:100%;margin:0}}
</style>
<script>
 const allowed = new Set(["--primary", "--card-bg", "--card-bg-transparent", "--line-divider", "--deep-text", "--content-meta", "--btn-content", "--btn-regular-bg"]);
 window.addEventListener("message", event => {
  if(event.source!==parent || event.origin!==location.origin || event.data?.type!=="firefly:moment-comments-theme")return;
  document.documentElement.classList.toggle("dark",event.data.dark===true);
  document.body.classList.toggle("wallpaper-transparent",event.data.transparent===true);
  document.documentElement.dataset.language=event.data.language==="en"?"en":"zh-CN";
  for(const [key,value] of Object.entries(event.data.palette||{})) if(allowed.has(key)&&typeof value==="string")document.documentElement.style.setProperty(key,value);
  document.dispatchEvent(new CustomEvent("firefly:language-change"));
 });
 const report=()=>parent.postMessage({type:"firefly:moment-comments-size",height:Math.ceil(document.body.getBoundingClientRect().height)+4},location.origin);
 new ResizeObserver(report).observe(document.body);
 window.addEventListener("load",report);
</script>
