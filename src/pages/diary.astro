---
import { Icon } from "astro-icon/components";
import PersonalPageHeader from "@/components/pages/personal/PersonalPageHeader.astro";
import SocialFeedCard from "@/components/pages/personal/SocialFeedCard.astro";
import { personalPagesConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const config = personalPagesConfig.diary;
const items = [...config.items].sort(
	(a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
const tags = [...new Set(items.flatMap((item) => item.tags || []))];
---

<MainGridLayout title={config.title} description={config.description}>
	<section class="card-base mb-4 p-5 sm:p-7 lg:p-9">
		<PersonalPageHeader
			title={config.title}
			description={config.description}
			icon="material-symbols:book-2-rounded"
		/>
		<div class="mb-1 flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-400">
			<Icon is:inline name="material-symbols:edit-note-rounded" class="text-xl text-(--primary)" />
			<span>{items.length} 条日记</span>
		</div>

		{tags.length > 0 && (
			<diary-filter class="mt-5 flex flex-wrap gap-2">
				<button
					type="button"
					data-tag="all"
					aria-pressed="true"
					class="diary-filter-button rounded-full px-3.5 py-1.5 text-sm transition-all"
				>
					全部
				</button>
				{tags.map((tag) => (
					<button
						type="button"
						data-tag={tag}
						aria-pressed="false"
						class="diary-filter-button rounded-full px-3.5 py-1.5 text-sm transition-all"
					>
						#{tag}
					</button>
				))}
			</diary-filter>
		)}
	</section>

	<div data-diary-list class="space-y-4">
		{items.length > 0 ? (
			items.map((item) => (
				<div data-diary-card data-tags={JSON.stringify(item.tags || [])}>
					<SocialFeedCard item={item} variant="diary" />
				</div>
			))
		) : (
			<div class="card-base p-12 text-center text-neutral-400">
				<Icon is:inline name="material-symbols:book-2-outline-rounded" class="mb-3 text-5xl" />
				<p>暂时还没有日记</p>
			</div>
		)}
	</div>
	<div data-diary-empty class="card-base hidden p-12 text-center text-neutral-400">
		<Icon is:inline name="material-symbols:filter-alt-off-rounded" class="mb-3 text-5xl" />
		<p>这个标签下暂时没有日记</p>
	</div>
</MainGridLayout>

<style>
	@reference "../styles/main.css";

	.diary-filter-button {
		@apply bg-(--btn-regular-bg) text-neutral-600 hover:text-(--primary) dark:text-neutral-300;
	}

	.diary-filter-button[aria-pressed="true"] {
		@apply bg-(--primary) text-white shadow-sm dark:text-black/70;
	}
</style>

<script>
	if (!customElements.get("diary-filter")) {
		class DiaryFilter extends HTMLElement {
			connectedCallback() {
				this.addEventListener("click", this.handleClick);
			}

			disconnectedCallback() {
				this.removeEventListener("click", this.handleClick);
			}

			handleClick = (event: Event) => {
				const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
					"button[data-tag]",
				);
				if (!button || !this.contains(button)) return;

				this.querySelectorAll<HTMLButtonElement>("button[data-tag]").forEach(
					(filterButton) => {
						filterButton.setAttribute(
							"aria-pressed",
							String(filterButton === button),
						);
					},
				);

				const selectedTag = button.dataset.tag || "all";
				let visibleCount = 0;
				document.querySelectorAll<HTMLElement>("[data-diary-card]").forEach((card) => {
					const tags = JSON.parse(card.dataset.tags || "[]") as string[];
					const visible = selectedTag === "all" || tags.includes(selectedTag);
					card.classList.toggle("hidden", !visible);
					if (visible) visibleCount += 1;
				});
				document
					.querySelector<HTMLElement>("[data-diary-empty]")
					?.classList.toggle("hidden", visibleCount > 0);
			};
		}

		customElements.define("diary-filter", DiaryFilter);
	}
</script>
