---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import LocalizedText from "@/components/common/LocalizedText.astro";
import { profileConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const skillGroups = [
	{
		title: "Software Development",
		label: "软件开发",
		labelEn: "Software development",
		icon: "material-symbols:code-rounded",
		items: [
			{
				title: "Java",
				description: "面向对象编程、数据结构与应用开发",
				descriptionEn:
					"Object-oriented programming, data structures, and application development",
			},
			{
				title: "HTML / CSS / JavaScript",
				description: "响应式网页与前端交互开发",
				descriptionEn:
					"Responsive web interfaces and front-end interaction development",
			},
			{
				title: "SQL & Databases",
				description: "关系型数据库设计、查询与数据管理",
				descriptionEn:
					"Relational database design, querying, and data management",
			},
			{
				title: "Backend Development",
				description: "REST API、业务逻辑与数据库集成",
				descriptionEn: "REST APIs, business logic, and database integration",
			},
			{
				title: "Software Architecture",
				description: "MVC、分层架构与模块化系统设计",
				descriptionEn: "MVC, layered architecture, and modular system design",
			},
			{
				title: "Git & GitHub",
				description: "版本控制、分支管理与团队协作",
				descriptionEn:
					"Version control, branch management, and team collaboration",
			},
			{
				title: "Software Testing",
				description: "单元测试、集成测试与质量保证",
				descriptionEn:
					"Unit testing, integration testing, and quality assurance",
			},
		],
	},
	{
		title: "Interaction Design",
		label: "交互设计",
		labelEn: "Interaction design",
		icon: "material-symbols:design-services-outline-rounded",
		items: [
			{
				title: "UI / UX Design",
				description: "以用户为中心的网页与应用界面设计",
				descriptionEn:
					"User-centered interface design for websites and applications",
			},
			{
				title: "Figma & Prototyping",
				description: "线框图、高保真界面与交互原型",
				descriptionEn:
					"Wireframes, high-fidelity interfaces, and interactive prototypes",
			},
			{
				title: "User Research",
				description: "用户访谈、用户画像与可用性测试",
				descriptionEn: "User interviews, personas, and usability testing",
			},
		],
	},
	{
		title: "Business & Systems",
		label: "业务与系统",
		labelEn: "Business and systems",
		icon: "material-symbols:account-tree-outline-rounded",
		items: [
			{
				title: "Business Analysis",
				description: "业务需求分析与系统功能规划",
				descriptionEn:
					"Business requirements analysis and system feature planning",
			},
			{
				title: "System Modelling",
				description: "UML、ERD、Use Case 与业务流程建模",
				descriptionEn: "UML, ERD, use cases, and business process modelling",
			},
			{
				title: "Agile & Scrum",
				description: "迭代开发、任务规划与团队协作",
				descriptionEn:
					"Iterative development, task planning, and team collaboration",
			},
			{
				title: "IT Project Management",
				description: "项目范围、风险、进度与交付管理",
				descriptionEn: "Project scope, risk, schedule, and delivery management",
			},
		],
	},
] as const;
---

<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
	<section class="card-base w-full overflow-hidden p-5 sm:p-7 lg:p-9">
		<section class="about-profile mb-10 border-b border-(--line-divider) pb-9" aria-labelledby="about-profile-title">
			<h1 id="about-profile-title" class="mb-8 text-3xl font-bold text-neutral-900 dark:text-neutral-100">
				<LocalizedText zh="关于我？" en="About Me?" />
			</h1>

			<div class="mb-7 flex justify-center">
				<div class="rounded-[1.45rem] bg-linear-to-br from-(--primary)/25 to-(--primary)/5 p-1.5 shadow-lg shadow-(--primary)/10">
					<ImageWrapper
						src={profileConfig.avatar || "assets/images/avatar.avif"}
						alt="Sky 的头像"
						position="30% 44%"
						class="h-24 w-24 rounded-[1.15rem] ring-1 ring-white/70 sm:h-28 sm:w-28"
						widths={[96, 112, 192, 224]}
						sizes="(min-width: 640px) 112px, 96px"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			</div>

			<div class="mx-auto max-w-3xl text-center text-[0.95rem] font-medium leading-8 text-neutral-700 dark:text-neutral-300 sm:text-base">
				<LocalizedText
					zh="Hi，你好呀！欢迎访问我的个人网站……我是 Sky，喜欢折腾各种数码产品和电脑周边，喜欢 AI，拥抱 Agent。"
					en="Hi, welcome to my personal website! I'm Sky. I enjoy tinkering with digital products and computer gear, exploring AI, and embracing agents."
				/>
				<br />
				<LocalizedText zh="目前坐标悉尼，在上学……" en="I'm currently studying in Sydney." />
				<br />
				<LocalizedText
					zh="“小小菠萝（xiaoxiaoboluo）”是我初中的外号吧，以此用作我的域名。"
					en="Xiaoxiaoboluo was a nickname from middle school, so I made it my domain name."
				/>
				<br />
				<LocalizedText
					zh="欢迎通过 GitHub、邮箱、微信、QQ 与我交流。"
					en="You're welcome to reach me through GitHub, email, WeChat, or QQ."
				/>
			</div>

			<ul class="mx-auto mt-8 grid max-w-3xl gap-3 text-[0.95rem] leading-relaxed text-neutral-700 dark:text-neutral-300">
				<li class="about-detail-item">
					<span aria-hidden="true">🖥️</span>
					<span><strong><LocalizedText zh="兴趣爱好：" en="Interests: " /></strong><LocalizedText zh="折腾电脑、打游戏、玩 AI" en="Tinkering with computers, gaming, and exploring AI" /></span>
				</li>
				<li class="about-detail-item">
					<span aria-hidden="true">🎨</span>
					<span><strong><LocalizedText zh="最爱颜色：" en="Favourite colours: " /></strong><LocalizedText zh="天蓝色和软 fufu 的樱花粉色系喵～" en="Sky blue and soft, fluffy cherry-blossom pink" /></span>
				</li>
				<li class="about-detail-item">
					<span aria-hidden="true">🎵</span>
					<span><strong><LocalizedText zh="喜爱音乐：" en="Favourite music: " /></strong>ACG Music</span>
				</li>
				<li class="about-detail-item">
					<span aria-hidden="true">🎮</span>
					<span>
						<strong><LocalizedText zh="喜欢游戏：" en="Games: " /></strong>
						<LocalizedText zh="请详见 " en="See the " />
						<a class="about-link" href="/games/"><LocalizedText zh="我的－游戏" en="My - Games" /></a>
						<LocalizedText zh=" 板块" en=" section" />
					</span>
				</li>
				<li class="about-detail-item">
					<span aria-hidden="true">💗</span>
					<span><strong><LocalizedText zh="喜欢的人：" en="Someone special: " /></strong><LocalizedText zh=" /     （请详见左下角恋爱计时模块喵" en="“ / ” — see the relationship timer in the lower-left corner" /></span>
				</li>
			</ul>

			<div class="mx-auto mt-10 max-w-3xl">
				<h2 class="mb-4 text-2xl font-bold text-neutral-900 dark:text-neutral-100">
					<LocalizedText zh="社交账号：" en="Social Accounts:" />
				</h2>
				<ul class="grid gap-3 text-[0.95rem] text-neutral-700 dark:text-neutral-300">
					<li class="about-social-item">
						<span aria-hidden="true">•</span>
						<span>GitHub（<a class="about-link" href="https://github.com/Sky-Ultra" target="_blank" rel="noopener noreferrer"><LocalizedText zh="详见主页" en="profile" /></a>）</span>
					</li>
					<li class="about-social-item">
						<span aria-hidden="true">•</span>
						<span>BiliBili：<a class="about-link" href="https://space.bilibili.com/474735243" target="_blank" rel="noopener noreferrer">菠萝龘龘</a></span>
					</li>
				</ul>
			</div>

			<div class="mx-auto mt-10 max-w-3xl">
				<h2 class="mb-3 text-2xl font-bold text-neutral-900 dark:text-neutral-100">
					<LocalizedText zh="为什么建站？" en="Why this website?" />
				</h2>
				<p class="text-base font-medium text-neutral-700 dark:text-neutral-300">
					<LocalizedText zh="因为这里是我的地盘喵" en="Because this is my little corner of the internet." />
				</p>
			</div>
		</section>

		<div class="mb-7 flex items-center gap-3">
			<span class="h-7 w-1 rounded-full bg-(--primary)" aria-hidden="true"></span>
			<Icon
				is:inline
				name="material-symbols:stacks-rounded"
				class="text-[1.45rem] text-(--primary)"
				aria-hidden="true"
			/>
			<h2 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
				<LocalizedText zh="我的技术栈" en="My Tech Stack" />
			</h2>
		</div>

		<div class="space-y-10">
			{
				skillGroups.map((group) => (
					<section aria-labelledby={`skill-group-${group.title}`}>
						<header class="mb-5 flex items-center gap-3">
							<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-(--primary)/10 text-(--primary)">
								<Icon is:inline name={group.icon} class="text-[1.4rem]" />
							</div>
							<div class="min-w-0">
								<h3
									id={`skill-group-${group.title}`}
									class="text-xl font-bold text-neutral-900 dark:text-neutral-100"
								>
									{group.title}
								</h3>
								<p class="text-sm text-neutral-500 dark:text-neutral-400">
									<LocalizedText zh={group.label} en={group.labelEn} />
								</p>
							</div>
							<span class="ml-auto rounded-full bg-(--btn-regular-bg) px-3 py-1 text-xs font-medium text-neutral-500 dark:text-neutral-400">
								{group.items.length} <LocalizedText zh="项" en="items" />
							</span>
						</header>

						<div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
							{group.items.map((skill, index) => (
								<article class="group relative min-h-30 overflow-hidden rounded-xl border border-(--line-divider) bg-(--card-bg) p-5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-(--primary)/50 hover:shadow-md">
									<div class="absolute -right-8 -top-8 h-24 w-24 rounded-full bg-(--primary)/5 transition-transform duration-300 group-hover:scale-125" />
									<div class="relative z-10">
										<div class="mb-3 flex items-start justify-between gap-3">
											<h4 class="font-bold text-neutral-900 transition-colors group-hover:text-(--primary) dark:text-neutral-100">
												{skill.title}
											</h4>
											<span class="font-mono text-xs text-(--primary)/50">
												{String(index + 1).padStart(2, "0")}
											</span>
										</div>
										<p class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
											<LocalizedText zh={skill.description} en={skill.descriptionEn} />
										</p>
									</div>
								</article>
							))}
						</div>
					</section>
				))
			}
		</div>

		<section class="mt-12 border-t border-(--line-divider) pt-9" aria-labelledby="about-closing-title">
			<h2 id="about-closing-title" class="mb-5 text-2xl font-bold text-neutral-900 dark:text-neutral-100">
				<LocalizedText zh="最后" en="Finally" />
			</h2>
			<div class="space-y-1 text-base font-medium leading-7 text-neutral-700 dark:text-neutral-300">
				<p>
					<LocalizedText
						zh="感谢你的访问，希望这里的内容对你有所帮助！"
						en="Thank you for visiting. I hope you find something helpful here!"
					/>
				</p>
				<p>
					<LocalizedText
						zh="文笔不好，写的太乱，勿怪"
						en="Please forgive the rough writing and occasional disorder."
					/>
				</p>
			</div>
		</section>

		<section class="mt-10 border-t border-(--line-divider) pt-9" aria-labelledby="about-final-closing-title">
			<h2 id="about-final-closing-title" class="mb-5 text-2xl font-bold text-neutral-900 dark:text-neutral-100">
				<LocalizedText zh="最后的最后" en="The Very End" />
			</h2>
			<button
				type="button"
				class="about-secret"
				aria-expanded="false"
				data-about-secret
			>
				<span class="sr-only">
					<LocalizedText zh="隐藏文字，悬停或轻触后显示：" en="Hidden text. Hover or tap to reveal: " />
				</span>
				<span class="about-secret-content text-neutral-700 dark:text-neutral-300">
					<LocalizedText
						zh={`谢谢你可以看到这里，我喜欢你喵~
沃是优良少年喵，没有嗜好喵~
沃不抽烟，不喝酒，不赌博，不打牌，不去酒吧，不飙车，不钓鱼喵~
我愿将心向明月喵~

唯愿此行，终抵群星~`}
						en={`Thank you for making it all the way here. I like you, meow~
I'm a well-behaved youngster with no bad habits, meow~
I don't smoke, drink, gamble, play cards, go to bars, street race, or fish, meow~
I offer my heart to the bright moon, meow~

May this journey reach the stars at last~`}
					/>
				</span>
			</button>
		</section>
	</section>
</MainGridLayout>

<style>
	.about-detail-item,
	.about-social-item {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
	}

	.about-detail-item::marker,
	.about-social-item::marker {
		content: "";
	}

	.about-social-item > :first-child {
		color: var(--primary);
		font-size: 1.25rem;
		line-height: 1.15rem;
	}

	.about-link {
		color: var(--primary);
		font-weight: 700;
		text-decoration: none;
		text-underline-offset: 0.2em;
	}

	.about-link:hover {
		text-decoration: underline;
	}

	.about-secret {
		position: relative;
		display: block;
		width: 100%;
		max-width: 48rem;
		min-height: 10.5rem;
		overflow: hidden;
		border-radius: 0.85rem;
		background: color-mix(in oklch, var(--primary) 7%, transparent);
		padding: 1.25rem 1.4rem;
		text-align: left;
		cursor: pointer;
	}

	.about-secret::after {
		position: absolute;
		z-index: 2;
		inset: 0;
		border-radius: inherit;
		background: color-mix(in oklch, var(--primary) 58%, white 42%);
		content: "";
		transition: opacity 300ms ease, transform 300ms ease;
	}

	.about-secret-content {
		display: block;
		white-space: pre-line;
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.9;
		opacity: 0;
		filter: blur(0.4rem);
		transform: translateY(0.25rem);
		transition: opacity 300ms ease, filter 300ms ease, transform 300ms ease;
	}

	.about-secret:hover::after,
	.about-secret:focus-visible::after,
	.about-secret[aria-expanded="true"]::after {
		opacity: 0;
		transform: scale(0.985);
		pointer-events: none;
	}

	.about-secret:hover .about-secret-content,
	.about-secret:focus-visible .about-secret-content,
	.about-secret[aria-expanded="true"] .about-secret-content {
		opacity: 1;
		filter: blur(0);
		transform: translateY(0);
	}

	.about-secret:focus-visible {
		outline: 3px solid color-mix(in oklch, var(--primary) 45%, transparent);
		outline-offset: 0.25rem;
	}

	:global(.dark) .about-secret::after {
		background: color-mix(in oklch, var(--primary) 68%, #251d24 32%);
	}

	@media (prefers-reduced-motion: reduce) {
		.about-secret::after,
		.about-secret-content {
			transition: none;
		}
	}
</style>

<script>
	function initAboutSecrets() {
		document.querySelectorAll<HTMLButtonElement>("[data-about-secret]").forEach((secret) => {
			if (secret.dataset.secretReady === "true") return;

			secret.dataset.secretReady = "true";
			secret.addEventListener("click", () => {
				const isRevealed = secret.getAttribute("aria-expanded") === "true";
				secret.setAttribute("aria-expanded", String(!isRevealed));
			});
		});
	}

	initAboutSecrets();
	document.addEventListener("astro:page-load", initAboutSecrets);
</script>
