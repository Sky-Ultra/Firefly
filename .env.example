# Umami page-view collection (public identifiers; no API key is required here)
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Sidebar analytics card. Create a public Share URL for the same Umami website.
PUBLIC_UMAMI_SHARE_URL=

# Optional alternative: a same-origin read-only endpoint returning
# { "pageviews": 0, "visits": 0, "visitors": 0 }
PUBLIC_UMAMI_STATS_ENDPOINT=
